{% doc %}
Renders the Judge.me star rating badge for a product.

Always uses live Judge.me data. Note: the badge metafield quotes attributes with single
quotes (data-number-of-reviews='4'), so the parser below detects the quote character
rather than assuming double quotes. The previous version assumed double quotes, never
matched, and fell back to hardcoded theme settings that drifted out of date.

@param {product} product - The product whose rating is displayed.

@example
{% render 'judgeme-star-rating', product: product %}
{% enddoc %}

{% if product != blank %}
  {% liquid
    assign badge_markup = product.metafields.judgeme.badge | default: ''
    assign has_live_data = false
    assign live_count = 0
    if badge_markup contains 'data-number-of-reviews='
      assign after_count = badge_markup | split: 'data-number-of-reviews=' | last
      assign quote_char = after_count | slice: 0
      assign live_count = after_count | remove_first: quote_char | split: quote_char | first | plus: 0
      if live_count > 0
        assign has_live_data = true
      endif
    endif
  %}
  {% if has_live_data %}
    <div
      class="jdgm-widget jdgm-preview-badge"
      data-id="{{ product.id }}"
      data-auto-install="false"
    >
      {{ badge_markup }}
    </div>
  {% else %}
    <div class="judgeme-rating-empty" aria-label="{{ 'general.social_proof.no_verified_reviews' | t }}">
      <span aria-hidden="true">☆☆☆☆☆</span>
      <small>{{ 'general.social_proof.no_verified_reviews' | t }}</small>
    </div>
  {% endif %}
{% endif %}

{% stylesheet %}
  .judgeme-rating-empty{display:inline-flex;align-items:center;gap:8px;color:var(--rust)}
  .judgeme-rating-empty>span{font-size:14px;letter-spacing:2px;line-height:1}
  .judgeme-rating-empty small{color:var(--brown);font-size:10px;font-weight:900;letter-spacing:.8px;text-transform:uppercase}
  .jdgm-preview-badge{display:inline-flex;align-items:center}
  .jdgm-preview-badge .jdgm-prev-badge{display:inline-flex !important;align-items:center;gap:8px}
  .jdgm-preview-badge .jdgm-prev-badge__stars{color:var(--gold);font-size:14px;letter-spacing:2px;line-height:1}
  .jdgm-preview-badge .jdgm-prev-badge__text{color:var(--brown);font-size:10px;font-weight:900;letter-spacing:.8px;text-transform:uppercase}
{% endstylesheet %}
