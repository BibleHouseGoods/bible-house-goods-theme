{%- comment -%} Church volume pricing. Prices assume a single shipment to one address. {%- endcomment -%}
<section class="church-pricing" id="church-pricing">
  <div class="page-width">
    <div class="church-section-head church-section-head--split church-pricing__head">
      <div>
        <span class="eyebrow">{{ section.settings.pricing_kicker }}</span>
        <h2 class="section-title">{{ section.settings.pricing_heading }}</h2>
      </div>
      <p>{{ section.settings.pricing_intro }}</p>
    </div>

    <p class="church-ship-condition"><strong>One shipment, one address.</strong> {{ section.settings.ship_condition }}</p>

    <div class="church-price-table">
      <div class="church-price-row church-price-row--head">
        <span>Quantity</span><span>Per band</span><span>Example total</span>
      </div>
      {% for i in (1..5) %}
        {% liquid
          case i
            when 1
              assign q = section.settings.tier1_qty
              assign p = section.settings.tier1_price
              assign ex = section.settings.tier1_example
            when 2
              assign q = section.settings.tier2_qty
              assign p = section.settings.tier2_price
              assign ex = section.settings.tier2_example
            when 3
              assign q = section.settings.tier3_qty
              assign p = section.settings.tier3_price
              assign ex = section.settings.tier3_example
            when 4
              assign q = section.settings.tier4_qty
              assign p = section.settings.tier4_price
              assign ex = section.settings.tier4_example
            when 5
              assign q = section.settings.tier5_qty
              assign p = section.settings.tier5_price
              assign ex = section.settings.tier5_example
          endcase
        %}
        {% if q != blank %}
          <div class="church-price-row{% if i == 5 %} church-price-row--best{% endif %}">
            <span><strong>{{ q }}</strong> bands</span>
            <span class="church-price-row__price">{{ p }}</span>
            <span class="church-price-row__example">{{ ex }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    {% if section.settings.pricing_note != blank %}<p class="church-price-note">{{ section.settings.pricing_note }}</p>{% endif %}

    <div class="church-scope">
      <div class="church-scope__col church-scope__col--yes">
        <h3><span aria-hidden="true">✓</span> In every church pack</h3>
        <ul>
          <li>Bands in the sizes and colors you choose &mdash; mix freely across the order</li>
          <li>The full daily experience: Scripture, pastor-written devotion, guided prayer, audio, large print</li>
          <li>The free One-Year Bible Reading Plan</li>
          <li>A QR backup card for any phone that will not tap</li>
          <li>A one-page how-to sheet you can hand out</li>
          <li>Free shipping in one shipment to a single address</li>
          <li>A direct invoice &mdash; pay by card or church check</li>
        </ul>
      </div>
      <div class="church-scope__col church-scope__col--custom">
        <h3><span aria-hidden="true">✦</span> Custom, if you want it</h3>
        <ul>
          <li>A landing page built for your church, with your name, logo, and Scripture</li>
          <li>Bands that point to <strong>your own domain</strong> instead of ours</li>
          <li>A custom site or web app built around your ministry &mdash; bulletin, sermon notes, giving, events, next steps</li>
          <li>A destination we can update for you as seasons and series change</li>
        </ul>
        {% if section.settings.scope_note != blank %}<p>{{ section.settings.scope_note }}</p>{% endif %}
      </div>
    </div>

    <div class="church-price-cta">
      <a class="button button--gold" href="#church-inquiry">Request a quote for your group</a>
      <span>Need fewer than {{ section.settings.min_qty }}? The <a href="/products/the-bible-band">2, 3, and 4-packs</a> are on the product page.</span>
    </div>
  </div>
</section>

{% stylesheet %}
  .church-pricing{padding:clamp(80px,10vw,140px) 0;background:var(--cream);border-top:2px solid var(--ink)}
  .church-pricing__head>p{margin:0;color:var(--brown);font-size:16px;line-height:1.7}
  .church-ship-condition{margin:34px 0 0;padding:14px 18px;border-left:4px solid var(--rust);background:#e4d4bf;font-size:14px;line-height:1.6}
  .church-ship-condition strong{text-transform:uppercase;letter-spacing:.4px}
  .church-price-table{margin-top:18px;border:2px solid var(--ink);background:#f4ece2}
  .church-price-row{display:grid;grid-template-columns:1.1fr .8fr 1.1fr;gap:18px;align-items:baseline;padding:18px 24px;border-bottom:1px solid #cfc2b1}
  .church-price-row:last-child{border-bottom:0}
  .church-price-row--head{background:var(--ink);color:var(--cream);font-size:10px;font-weight:900;letter-spacing:1.6px;text-transform:uppercase}
  .church-price-row strong{font-size:19px;font-weight:900}
  .church-price-row__price{color:var(--rust);font-size:26px;font-weight:950;letter-spacing:-.02em}
  .church-price-row__example{color:var(--brown);font-size:14px}
  .church-price-row--best{background:var(--gold)}
  .church-price-row--best .church-price-row__price,.church-price-row--best .church-price-row__example{color:var(--ink)}
  .church-price-note{margin:16px 0 0;max-width:70ch;color:var(--brown);font-size:13px;line-height:1.6}
  .church-scope{display:grid;grid-template-columns:1fr 1fr;gap:18px;margin-top:40px}
  .church-scope__col{padding:28px;border:2px solid var(--ink)}
  .church-scope__col--yes{background:#e4d4bf}
  .church-scope__col--custom{background:var(--ink);color:var(--cream);box-shadow:8px 8px 0 var(--gold)}
  .church-scope__col h3{margin:0 0 16px;font-size:13px;font-weight:900;letter-spacing:1.2px;text-transform:uppercase}
  .church-scope__col--yes h3 span{margin-right:8px;color:var(--rust);font-size:16px}
  .church-scope__col--custom h3 span{margin-right:8px;color:var(--gold);font-size:16px}
  .church-scope__col ul{margin:0;padding:0;list-style:none}
  .church-scope__col li{padding:9px 0;border-top:1px solid rgba(10,9,8,.16);font-size:14px;line-height:1.55}
  .church-scope__col--custom li{border-top-color:#4e473e}
  .church-scope__col li:first-of-type{border-top:0}
  .church-scope__col--custom p{margin:14px 0 0;padding-top:14px;border-top:1px solid #4e473e;color:#c9c4bc;font-size:13px;line-height:1.6}
  .church-price-cta{display:flex;flex-wrap:wrap;align-items:center;gap:20px;margin-top:36px;padding-top:26px;border-top:2px solid var(--ink)}
  .church-price-cta span{color:var(--brown);font-size:13px;line-height:1.6}
  @media(max-width:900px){.church-scope{grid-template-columns:1fr}}
  @media(max-width:640px){.church-price-row{grid-template-columns:1fr auto;row-gap:4px;padding:16px 18px}.church-price-row--head{display:none}.church-price-row__example{grid-column:1/-1;font-size:12px}}
{% endstylesheet %}
