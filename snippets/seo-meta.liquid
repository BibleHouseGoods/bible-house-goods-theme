{%- comment -%}
  Central SEO metadata. Page titles and descriptions remain editable in Shopify.
  This snippet adds page-aware social cards and JSON-LD without hard-coding URLs.
{%- endcomment -%}
{%- liquid
  assign seo_title = page_title | default: shop.name
  assign seo_description = page_description
  if seo_description == blank and request.page_type == 'product'
    assign seo_description = product.description | strip_html | strip_newlines | truncate: 160
  elsif seo_description == blank and request.page_type == 'collection'
    assign seo_description = collection.description | strip_html | strip_newlines | truncate: 160
  elsif seo_description == blank and request.page_type == 'article'
    assign seo_description = article.excerpt_or_content | strip_html | strip_newlines | truncate: 160
  elsif seo_description == blank and request.page_type == 'page'
    assign seo_description = page.content | strip_html | strip_newlines | truncate: 160
  endif
  assign seo_description = seo_description | default: shop.description | strip_html | strip_newlines
  if request.page_type == 'index' and seo_description == blank
    assign seo_description = "Shop The Bible Band™ and faith-based goods from Bible House Goods. Build a simple daily habit of Scripture, prayer, and devotion—no app or subscription."
  endif

  assign seo_image = settings.social_share_image
  if request.page_type == 'product' and product.featured_media.preview_image != blank
    assign seo_image = product.featured_media.preview_image
  elsif request.page_type == 'article' and article.image != blank
    assign seo_image = article.image
  elsif request.page_type == 'collection' and collection.image != blank
    assign seo_image = collection.image
  elsif request.page_type == 'blog' and blog.articles.first.image != blank
    assign seo_image = blog.articles.first.image
  elsif seo_image == blank
    assign seo_image = all_products['the-bible-band'].featured_image
  endif

  assign og_type = 'website'
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
-%}

<title>{{ seo_title }}{% if current_tags %} – {{ current_tags | join: ', ' }}{% endif %}{% if current_page != 1 %} – Page {{ current_page }}{% endif %}{% unless seo_title contains shop.name %} – {{ shop.name }}{% endunless %}</title>
{% if seo_description != blank %}<meta name="description" content="{{ seo_description | escape }}">{% endif %}
<meta name="robots" content="{% if request.page_type == 'search' or request.page_type == 'cart' %}noindex,follow{% else %}index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1{% endif %}">

<meta property="og:site_name" content="{{ shop.name | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ seo_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
{% if seo_description != blank %}<meta property="og:description" content="{{ seo_description | escape }}">{% endif %}
{% if seo_image != blank %}
  <meta property="og:image" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ seo_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:alt" content="{{ seo_image.alt | default: seo_title | escape }}">
{% endif %}
{% if request.page_type == 'product' %}
  <meta property="product:price:amount" content="{{ product.selected_or_first_available_variant.price | divided_by: 100.0 }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
{% elsif request.page_type == 'article' %}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{% endif %}

<meta name="twitter:card" content="{% if seo_image != blank %}summary_large_image{% else %}summary{% endif %}">
<meta name="twitter:title" content="{{ seo_title | escape }}">
{% if seo_description != blank %}<meta name="twitter:description" content="{{ seo_description | escape }}">{% endif %}
{% if seo_image != blank %}<meta name="twitter:image" content="https:{{ seo_image | image_url: width: 1200 }}">{% endif %}

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": {{ shop.name | json }},
  "url": {{ shop.url | append: routes.root_url | json }}{% if settings.logo != blank %},
  "logo": {{ settings.logo | image_url: width: 600 | prepend: "https:" | json }}{% endif %}
}
</script>

{% if request.page_type == 'index' %}
  {%- capture seo_search_placeholder -%}{search_term_string}{%- endcapture -%}
  {%- assign seo_search_target = shop.url | append: routes.search_url | append: '?q=' | append: seo_search_placeholder -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": {{ shop.url | append: routes.root_url | json }},
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": {{ seo_search_target | json }}
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
{% elsif request.page_type == 'product' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ shop.url | append: product.url | json }},
    "description": {{ product.description | strip_html | strip_newlines | json }},
    {% if product.featured_media.preview_image != blank %}"image": [{{ product.featured_media.preview_image | image_url: width: 1200 | prepend: "https:" | json }}],{% endif %}
    {% if product.vendor != blank %}"brand": {"@type": "Brand", "name": {{ product.vendor | json }}},{% endif %}
    {% if product.selected_or_first_available_variant.sku != blank %}"sku": {{ product.selected_or_first_available_variant.sku | json }},{% endif %}
    {%- comment -%} One Product block with price AND rating, from Judge.me's standard review metafields. {%- endcomment -%}
    {% if product.metafields.reviews.rating_count.value > 0 and product.metafields.reviews.rating.value != blank %}"aggregateRating": {"@type": "AggregateRating", "ratingValue": {{ product.metafields.reviews.rating.value.rating | json }}, "reviewCount": {{ product.metafields.reviews.rating_count.value | json }}, "bestRating": {{ product.metafields.reviews.rating.value.scale_max | json }}, "worstRating": {{ product.metafields.reviews.rating.value.scale_min | json }}},{% endif %}
    "offers": [
      {% for variant in product.variants %}
        {
          "@type": "Offer",
          "url": {{ shop.url | append: variant.url | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "availability": "https://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "itemCondition": "https://schema.org/NewCondition"{% if variant.sku != blank %},
          "sku": {{ variant.sku | json }}{% endif %}
        }{% unless forloop.last %},{% endunless %}
      {% endfor %}
    ]
  }
  </script>
{% elsif request.page_type == 'article' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": {{ article.title | json }},
    "description": {{ seo_description | json }},
    "url": {{ shop.url | append: article.url | json }},
    "datePublished": {{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "dateModified": {{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' | json }},
    "author": {"@type": "Person", "name": {{ article.author | json }}},
    "publisher": {"@type": "Organization", "name": {{ shop.name | json }}}{% if article.image != blank %},
    "image": {{ article.image | image_url: width: 1200 | prepend: "https:" | json }}{% endif %}
  }
  </script>
{% endif %}

{% unless request.page_type == 'index' or request.page_type == 'cart' or request.page_type == 'search' or request.page_type == '404' %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      {"@type": "ListItem", "position": 1, "name": "Home", "item": {{ shop.url | append: routes.root_url | json }}},
      {"@type": "ListItem", "position": 2, "name": {{ seo_title | json }}, "item": {{ canonical_url | json }}}
    ]
  }
  </script>
{% endunless %}
