# ---------------------------------------------------------------------------
# Life OS environment. Set these in Vercel → Project → Settings → Environment
# Variables (mark them Sensitive). None are NEXT_PUBLIC_, so none reach the
# browser. Never commit a real .env file.
# ---------------------------------------------------------------------------

# Public URL of the deployment (no trailing slash). Used for OAuth redirects.
APP_URL=https://life-os.example.vercel.app
# IANA time zone used to resolve "tomorrow at 3" and for calendar events.
APP_TIMEZONE=America/Chicago

# Login passphrase hash:  npm run hash-password -- 'a long passphrase'
APP_PASSWORD_HASH=scrypt$...$...
# Session signing secret:  openssl rand -hex 32
SESSION_SECRET=
# Encrypts the Google refresh token + upload sessions at rest:  openssl rand -base64 32
ENCRYPTION_KEY=

# Supabase → Project Settings → API. Service role key is server-only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# OpenAI
OPENAI_API_KEY=
# whisper-1 returns timestamps and keeps disfluencies best. gpt-4o-transcribe also works.
OPENAI_TRANSCRIBE_MODEL=whisper-1
# Used for the clean transcript and classification.
OPENAI_TEXT_MODEL=gpt-5
# Optional, for reasoning models: minimal | low | medium | high
OPENAI_REASONING_EFFORT=low

# Google Cloud OAuth client (Web application).
# Authorized redirect URI: ${APP_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Only this Google account may be connected.
GOOGLE_ALLOWED_EMAIL=you@gmail.com
GOOGLE_CALENDAR_ID=primary
GOOGLE_DRIVE_ROOT_NAME=Life OS

# Todoist → Settings → Integrations → Developer → API token
TODOIST_API_TOKEN=
# Optional: Todoist project id per area (otherwise tasks go to Inbox with an area label)
TODOIST_PROJECT_LIFE=
TODOIST_PROJECT_CHURCH=
TODOIST_PROJECT_BIBLE_HOUSE=
TODOIST_PROJECT_LIBERTY=
