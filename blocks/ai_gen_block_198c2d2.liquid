{% doc %}
  @prompt
    Create a cart block named "Bible Band $6 Soap Add-On" with four product settings soap_1 through soap_4. Render the block hidden by default. Use one small inline scoped script with no network calls, storage, cookies, analytics, external code, or global variables. Show the block only when the cart product table inside main contains a product link whose href includes "/products/the-bible-band?variant=". Keep it hidden if a cart product link already matches any selected soap handle. For each selected available soap show its Shopify image, title, struck-through $10, "$6 with your Bible Band", and a standard POST form to routes.cart_add_url with variant id, quantity 1, return_to /cart, button "Add soap for $6". Heading: "Add a soap for $6". Note: "Your Bible Band unlocks one $6 soap. Discount applies automatically." Four columns desktop, two mobile. Use only Liquid, HTML, scoped CSS and that scoped visibility script. No external assets. Do not change product prices.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign soap_handles = '' %}
{% for i in (1..4) %}
  {% liquid
    assign soap_key = 'soap_' | append: i
    assign soap = block.settings[soap_key]
  %}
  {% if soap != blank %}
    {% assign soap_handles = soap_handles | append: soap.handle | append: ',' %}
  {% endif %}
{% endfor %}

{% style %}
  .ai-soap-addon-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 24px auto;
    padding: 24px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 10px;
    box-sizing: border-box;
  }

  .ai-soap-addon-{{ ai_gen_id }}[hidden] {
    display: none;
  }

  .ai-soap-addon-{{ ai_gen_id }}__heading {
    margin: 0 0 6px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }}, sans-serif;
    font-size: 24px;
    line-height: 1.2;
  }

  .ai-soap-addon-{{ ai_gen_id }}__note {
    margin: 0 0 20px;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    line-height: 1.5;
  }

  .ai-soap-addon-{{ ai_gen_id }}__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-soap-addon-{{ ai_gen_id }}__item {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 9px;
  }

  .ai-soap-addon-{{ ai_gen_id }}__image,
  .ai-soap-addon-{{ ai_gen_id }}__placeholder {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 7px;
    background: {{ block.settings.placeholder_color }};
  }

  .ai-soap-addon-{{ ai_gen_id }}__placeholder {
    padding: 20%;
    box-sizing: border-box;
  }

  .ai-soap-addon-{{ ai_gen_id }}__placeholder svg {
    width: 100%;
    height: 100%;
  }

  .ai-soap-addon-{{ ai_gen_id }}__title {
    margin: 0;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 15px;
    font-weight: 700;
    line-height: 1.3;
  }

  .ai-soap-addon-{{ ai_gen_id }}__price {
    margin: 0;
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 14px;
    line-height: 1.4;
  }

  .ai-soap-addon-{{ ai_gen_id }}__original {
    color: {{ block.settings.muted_color }};
    margin-right: 4px;
  }

  .ai-soap-addon-{{ ai_gen_id }}__button {
    width: 100%;
    min-height: 42px;
    padding: 10px 8px;
    border: 0;
    border-radius: 5px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    font-family: {{ block.settings.body_font.family }}, sans-serif;
    font-size: 13px;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }

  .ai-soap-addon-{{ ai_gen_id }}__button:hover {
    background: {{ block.settings.button_hover_color }};
  }

  .ai-soap-addon-{{ ai_gen_id }}__button:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 2px;
  }

  @media screen and (max-width: 749px) {
    .ai-soap-addon-{{ ai_gen_id }} {
      width: 100%;
      padding: 20px 16px;
    }

    .ai-soap-addon-{{ ai_gen_id }}__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
{% endstyle %}

<bible-band-soap-addon-{{ ai_gen_id }}
  class="ai-soap-addon-{{ ai_gen_id }}"
  data-soap-handles="{{ soap_handles | escape }}"
  hidden
  {{ block.shopify_attributes }}
>
  <h2 class="ai-soap-addon-{{ ai_gen_id }}__heading">Add a soap for $6</h2>
  <p class="ai-soap-addon-{{ ai_gen_id }}__note">Your Bible Band unlocks one $6 soap. Discount applies automatically.</p>
  <div class="ai-soap-addon-{{ ai_gen_id }}__grid">
    {% for i in (1..4) %}
      {% liquid
        assign soap_key = 'soap_' | append: i
        assign soap = block.settings[soap_key]
        if soap != blank
          assign soap_variant = soap.selected_or_first_available_variant
        endif
      %}
      {% if soap != blank and soap.available and soap_variant != blank and soap_variant.available %}
        <div class="ai-soap-addon-{{ ai_gen_id }}__item" data-soap-handle="{{ soap.handle | escape }}">
          {% if soap.featured_image %}
            <img
              class="ai-soap-addon-{{ ai_gen_id }}__image"
              src="{{ soap.featured_image | image_url: width: 500 }}"
              alt="{{ soap.featured_image.alt | default: soap.title | escape }}"
              loading="lazy"
              width="500"
              height="500"
            >
          {% else %}
            <div class="ai-soap-addon-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
          {% endif %}
          <h3 class="ai-soap-addon-{{ ai_gen_id }}__title">{{ soap.title }}</h3>
          <p class="ai-soap-addon-{{ ai_gen_id }}__price"><s class="ai-soap-addon-{{ ai_gen_id }}__original">$10</s> $6 with your Bible Band</p>
          <form method="post" action="{{ routes.cart_add_url }}">
            <input type="hidden" name="id" value="{{ soap_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <input type="hidden" name="return_to" value="/cart">
            <button class="ai-soap-addon-{{ ai_gen_id }}__button" type="submit">Add soap for $6</button>
          </form>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</bible-band-soap-addon-{{ ai_gen_id }}>

<script>
  (() => {
    const addon = document.querySelector('bible-band-soap-addon-{{ ai_gen_id }}');
    if (!addon) return;
    const main = document.querySelector('main');
    if (!main) return;
    const bandLink = main.querySelector('a[href*="/products/the-bible-band?variant="]');
    if (!bandLink) return;
    const handles = addon.dataset.soapHandles.split(',').filter(Boolean);
    const soapAlreadyInCart = handles.some((handle) => main.querySelector(`a[href*="/products/${handle}"]`));
    if (!soapAlreadyInCart && addon.querySelector('[data-soap-handle]')) addon.hidden = false;
  })();
</script>

{% schema %}
{
  "name": "Bible Band $6 Soap Add-On",
  "settings": [
    { "type": "header", "content": "Soap products" },
    { "type": "product", "id": "soap_1", "label": "Soap 1" },
    { "type": "product", "id": "soap_2", "label": "Soap 2" },
    { "type": "product", "id": "soap_3", "label": "Soap 3" },
    { "type": "product", "id": "soap_4", "label": "Soap 4" },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#EAE0D5" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#0A0908" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#0A0908" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5E503F" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#C6AC8F" },
    { "type": "color", "id": "placeholder_color", "label": "Placeholder", "default": "#C6AC8F" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#0A0908" },
    { "type": "color", "id": "button_hover_color", "label": "Button hover", "default": "#5E503F" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#FFFFFF" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#C1440E" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "assistant_n7" },
    { "type": "font_picker", "id": "body_font", "label": "Body font", "default": "assistant_n4" }
  ],
  "presets": [{ "name": "Bible Band $6 Soap Add-On" }],
  "tag": null,
  "class": "bible-band-soap-addon-block"
}
{% endschema %}