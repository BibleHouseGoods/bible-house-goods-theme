{% doc %}
  @prompt
    Create a simple responsive promotional image section with one Shopify image picker. Show the selected square image centered at a maximum width of 560px on desktop and full width on mobile, preserving its 1:1 ratio. Add comfortable cream-colored padding above and below. No text, no animation, no JavaScript, no external links, and no external assets.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-promotional-image-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: #EAE0D5;
    padding: 48px 20px;
  }

  .ai-promotional-image__frame-{{ ai_gen_id }} {
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 560px;
    aspect-ratio: 1 / 1;
    margin: 0 auto;
    overflow: hidden;
    background-color: #f5eee7;
  }

  .ai-promotional-image__frame-{{ ai_gen_id }} img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-promotional-image__placeholder-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    color: #5E503F;
  }

  .ai-promotional-image__placeholder-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media screen and (max-width: 749px) {
    .ai-promotional-image-{{ ai_gen_id }} {
      padding: 32px 16px;
    }

    .ai-promotional-image__frame-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<div class="ai-promotional-image-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-promotional-image__frame-{{ ai_gen_id }}">
    {% if block.settings.image != blank %}
      <img
        src="{{ block.settings.image | image_url: width: 1120 }}"
        alt="{{ block.settings.image.alt | escape }}"
        width="{{ block.settings.image.width }}"
        height="{{ block.settings.image.height }}"
        loading="lazy"
      >
    {% else %}
      <div class="ai-promotional-image__placeholder-{{ ai_gen_id }}">
        {{ 'image' | placeholder_svg_tag }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Promotional image",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Promotional image"
    }
  ],
  "tag": null,
  "class": "promotional-image-block"
}
{% endschema %}