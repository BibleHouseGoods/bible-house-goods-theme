{% doc %}
  @prompt
    Create a responsive split-layout newsletter hero block. Left side: one Shopify image picker showing a square image at full width. Right side: heading with default text FREE ROMANS STUDY GUIDE, body copy with default text Get the complete chapter-by-chapter guide—verse walkthroughs, historical context, reflection questions, prayer prompts, and space for notes., and a native Shopify customer newsletter form with one required email field, hidden newsletter tag, submit button text Send me the guide, success message Check your inbox—the guide is on its way., and consent note By signing up, you agree to receive email from Bible House Goods. Unsubscribe anytime. Use a warm cream background, thick near-black border, mustard-gold offset shadow, editorial serif heading, generous spacing, and stack image above copy on mobile. The whole block must feel like one cohesive hero box. Use only Shopify Liquid, HTML, and scoped CSS. No JavaScript, no external links, no external assets, no tracking, no SMS field.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-newsletter-hero-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;margin:0 auto}.ai-newsletter-hero__box-{{ ai_gen_id }}{display:grid;grid-template-columns:1fr 1fr;background:{{ block.settings.background_color }};border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }};box-shadow:{{ block.settings.shadow_offset }}px {{ block.settings.shadow_offset }}px 0 {{ block.settings.shadow_color }};overflow:hidden}.ai-newsletter-hero__media-{{ ai_gen_id }}{aspect-ratio:1/1;background:{{ block.settings.image_placeholder_color }};min-width:0}.ai-newsletter-hero__media-{{ ai_gen_id }} img,.ai-newsletter-hero__media-{{ ai_gen_id }} svg{display:block;width:100%;height:100%;object-fit:cover}.ai-newsletter-hero__copy-{{ ai_gen_id }}{display:flex;flex-direction:column;justify-content:center;padding:clamp(32px,6vw,76px);color:{{ block.settings.text_color }}}.ai-newsletter-hero__heading-{{ ai_gen_id }}{margin:0 0 22px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }},serif;font-size:clamp(34px,4.5vw,68px);line-height:.98;letter-spacing:-.04em}.ai-newsletter-hero__body-{{ ai_gen_id }}{margin:0 0 28px;max-width:540px;font-family:{{ block.settings.body_font.family }},sans-serif;font-size:{{ block.settings.body_font_size }}px;line-height:1.55}.ai-newsletter-hero__form-{{ ai_gen_id }}{max-width:540px}.ai-newsletter-hero__field-{{ ai_gen_id }}{display:flex;gap:10px}.ai-newsletter-hero__input-{{ ai_gen_id }}{min-width:0;flex:1;padding:15px 16px;color:{{ block.settings.text_color }};background:{{ block.settings.input_background }};border:2px solid {{ block.settings.border_color }};border-radius:0;font:inherit;font-size:16px}.ai-newsletter-hero__button-{{ ai_gen_id }}{padding:15px 22px;color:{{ block.settings.button_text_color }};background:{{ block.settings.button_color }};border:2px solid {{ block.settings.border_color }};cursor:pointer;font-weight:700}.ai-newsletter-hero__button-{{ ai_gen_id }}:hover{background:{{ block.settings.button_hover_color }};}.ai-newsletter-hero__input-{{ ai_gen_id }}:focus,.ai-newsletter-hero__button-{{ ai_gen_id }}:focus-visible{outline:3px solid {{ block.settings.focus_color }};outline-offset:3px}.ai-newsletter-hero__consent-{{ ai_gen_id }}{margin:14px 0 0;color:{{ block.settings.muted_text_color }};font-size:13px;line-height:1.45}.ai-newsletter-hero__message-{{ ai_gen_id }}{margin-top:16px;font-weight:700}.ai-newsletter-hero__message--success-{{ ai_gen_id }}{color:{{ block.settings.success_color }}}.ai-newsletter-hero__message--error-{{ ai_gen_id }}{color:{{ block.settings.error_color }}}@media(max-width:749px){.ai-newsletter-hero-{{ ai_gen_id }}{width:100%}.ai-newsletter-hero__box-{{ ai_gen_id }}{display:block}.ai-newsletter-hero__copy-{{ ai_gen_id }}{padding:34px 24px 38px}.ai-newsletter-hero__field-{{ ai_gen_id }}{display:flex;flex-direction:column}.ai-newsletter-hero__button-{{ ai_gen_id }}{width:100%}}
{% endstyle %}
<newsletter-hero-{{ ai_gen_id }} class="ai-newsletter-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-newsletter-hero__box-{{ ai_gen_id }}"><div class="ai-newsletter-hero__media-{{ ai_gen_id }}">{% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1400 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}{{ 'image' | placeholder_svg_tag }}{% endif %}</div><div class="ai-newsletter-hero__copy-{{ ai_gen_id }}"><h2 class="ai-newsletter-hero__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2><div class="ai-newsletter-hero__body-{{ ai_gen_id }}">{{ block.settings.body }}</div>{% form 'customer' %}<input type="hidden" name="contact[tags]" value="Newsletter"><div class="ai-newsletter-hero__field-{{ ai_gen_id }}"><label for="NewsletterEmail-{{ ai_gen_id }}" class="visually-hidden">Email address</label><input id="NewsletterEmail-{{ ai_gen_id }}" class="ai-newsletter-hero__input-{{ ai_gen_id }}" type="email" name="contact[email]" value="{{ form.email | escape }}" placeholder="Email address" autocomplete="email" required aria-required="true"><button class="ai-newsletter-hero__button-{{ ai_gen_id }}" type="submit">{{ block.settings.button_label | escape }}</button></div>{% if form.posted_successfully? %}<p class="ai-newsletter-hero__message-{{ ai_gen_id }} ai-newsletter-hero__message--success-{{ ai_gen_id }}" role="status">{{ block.settings.success_message | escape }}</p>{% elsif form.errors %}<p class="ai-newsletter-hero__message-{{ ai_gen_id }} ai-newsletter-hero__message--error-{{ ai_gen_id }}" role="alert">{{ form.errors | default_errors }}</p>{% endif %}<p class="ai-newsletter-hero__consent-{{ ai_gen_id }}">{{ block.settings.consent_note | escape }}</p>{% endform %}</div></div></newsletter-hero-{{ ai_gen_id }}>
{% schema %}{"name":"Newsletter hero","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"heading","label":"Heading","default":"FREE ROMANS STUDY GUIDE"},{"type":"richtext","id":"body","label":"Body copy","default":"<p>Get the complete chapter-by-chapter guide—verse walkthroughs, historical context, reflection questions, prayer prompts, and space for notes.</p>"},{"type":"text","id":"button_label","label":"Button text","default":"Send me the guide"},{"type":"text","id":"success_message","label":"Success message","default":"Check your inbox—the guide is on its way."},{"type":"textarea","id":"consent_note","label":"Consent note","default":"By signing up, you agree to receive email from Bible House Goods. Unsubscribe anytime."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"border_width","label":"Border width","min":1,"max":8,"step":1,"unit":"px","default":4},{"type":"range","id":"shadow_offset","label":"Shadow offset","min":0,"max":24,"step":2,"unit":"px","default":10},{"type":"color","id":"background_color","label":"Background","default":"#EAE0D5"},{"type":"color","id":"border_color","label":"Border","default":"#0A0908"},{"type":"color","id":"shadow_color","label":"Shadow","default":"#E3A72B"},{"type":"color","id":"heading_color","label":"Heading","default":"#0A0908"},{"type":"color","id":"text_color","label":"Text","default":"#0A0908"},{"type":"color","id":"muted_text_color","label":"Muted text","default":"#5E503F"},{"type":"color","id":"input_background","label":"Input background","default":"#FFFDF9"},{"type":"color","id":"button_color","label":"Button","default":"#0A0908"},{"type":"color","id":"button_hover_color","label":"Button hover","default":"#5E503F"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"color","id":"focus_color","label":"Focus outline","default":"#C1440E"},{"type":"color","id":"image_placeholder_color","label":"Image placeholder","default":"#C6AC8F"},{"type":"color","id":"success_color","label":"Success","default":"#245B36"},{"type":"color","id":"error_color","label":"Error","default":"#9B2C20"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"serif"},{"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},{"type":"range","id":"body_font_size","label":"Body text size","min":14,"max":20,"step":1,"unit":"px","default":16}],"presets":[{"name":"Newsletter hero"}],"tag":null,"class":"newsletter-hero-block"}{% endschema %}