{% doc %}
  @prompt
    Create a responsive split-layout newsletter hero block. Left side: one Shopify image picker showing a square image at full width. Right side: heading with default text FREE ROMANS STUDY GUIDE, body copy with default text Get the complete chapter-by-chapter guide—verse walkthroughs, historical context, reflection questions, prayer prompts, and space for notes., and a native Shopify customer newsletter form with one required email field, hidden newsletter tag, submit button text Send me the guide, success message Check your inbox—the guide is on its way., and consent note By signing up, you agree to receive email from Bible House Goods. Unsubscribe anytime. Use a warm cream background, thick near-black border, mustard-gold offset shadow, editorial serif heading, generous spacing, and stack image above copy on mobile. The whole block must feel like one cohesive hero box. Use only Shopify Liquid, HTML, and scoped CSS. No JavaScript, no external links, no external assets, no tracking, no SMS field.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% capture form_id %}newsletter-hero-{{ ai_gen_id }}{% endcapture %}
{% capture form_class %}ai-newsletter-hero-{{ ai_gen_id }}__form{% endcapture %}
{% style %}
  .ai-newsletter-hero-{{ ai_gen_id }} { display:block; width:100%; }
  .ai-newsletter-hero-{{ ai_gen_id }}__box { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1fr); width:{{ block.settings.desktop_width_percent }}%; max-width:100%; margin:0 auto; background:{{ block.settings.background_color }}; border:{{ block.settings.border_width }}px solid {{ block.settings.border_color }}; box-shadow:{{ block.settings.shadow_offset }}px {{ block.settings.shadow_offset }}px 0 {{ block.settings.shadow_color }}; overflow:hidden; }
  .ai-newsletter-hero-{{ ai_gen_id }}__image-wrap { aspect-ratio:1/1; min-width:0; background:{{ block.settings.image_placeholder_color }}; }
  .ai-newsletter-hero-{{ ai_gen_id }}__image-wrap img,.ai-newsletter-hero-{{ ai_gen_id }}__placeholder { display:block; width:100%; height:100%; object-fit:cover; }
  .ai-newsletter-hero-{{ ai_gen_id }}__placeholder svg { width:100%; height:100%; color:{{ block.settings.muted_color }}; }
  .ai-newsletter-hero-{{ ai_gen_id }}__content { display:flex; flex-direction:column; justify-content:center; gap:{{ block.settings.content_gap }}px; padding:{{ block.settings.content_padding }}px; color:{{ block.settings.text_color }}; }
  .ai-newsletter-hero-{{ ai_gen_id }}__eyebrow { margin:0; color:{{ block.settings.accent_color }}; font-family:{{ block.settings.body_font.family }},sans-serif; font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; }
  .ai-newsletter-hero-{{ ai_gen_id }}__heading { margin:0; font-family:{{ block.settings.heading_font.family }},Georgia,serif; font-size:{{ block.settings.heading_size }}px; line-height:.98; letter-spacing:-.025em; }
  .ai-newsletter-hero-{{ ai_gen_id }}__body,.ai-newsletter-hero-{{ ai_gen_id }}__consent,.ai-newsletter-hero-{{ ai_gen_id }}__message { font-family:{{ block.settings.body_font.family }},sans-serif; }
  .ai-newsletter-hero-{{ ai_gen_id }}__body { margin:0; font-size:{{ block.settings.body_size }}px; line-height:1.55; }
  .ai-newsletter-hero-{{ ai_gen_id }}__form { display:flex; flex-direction:column; gap:10px; margin-top:8px; }
  .ai-newsletter-hero-{{ ai_gen_id }}__input { width:100%; min-height:52px; box-sizing:border-box; padding:14px 16px; border:2px solid {{ block.settings.border_color }}; border-radius:0; background:{{ block.settings.input_color }}; color:{{ block.settings.text_color }}; font:inherit; font-size:16px; }
  .ai-newsletter-hero-{{ ai_gen_id }}__input:focus-visible,.ai-newsletter-hero-{{ ai_gen_id }}__button:focus-visible { outline:3px solid {{ block.settings.accent_color }}; outline-offset:3px; }
  .ai-newsletter-hero-{{ ai_gen_id }}__button { min-height:52px; padding:14px 22px; border:2px solid {{ block.settings.border_color }}; border-radius:0; background:{{ block.settings.button_color }}; color:{{ block.settings.button_text_color }}; cursor:pointer; font-family:{{ block.settings.body_font.family }},sans-serif; font-size:15px; font-weight:700; letter-spacing:.03em; }
  .ai-newsletter-hero-{{ ai_gen_id }}__button:hover { background:{{ block.settings.button_hover_color }}; }
  .ai-newsletter-hero-{{ ai_gen_id }}__consent,.ai-newsletter-hero-{{ ai_gen_id }}__message { margin:0; font-size:13px; line-height:1.45; }
  .ai-newsletter-hero-{{ ai_gen_id }}__message--error { color:{{ block.settings.error_color }}; }
  .ai-newsletter-hero-{{ ai_gen_id }}__message--success { color:{{ block.settings.success_color }}; }
  @media screen and (max-width:749px) { .ai-newsletter-hero-{{ ai_gen_id }}__box { grid-template-columns:1fr; width:100%; } .ai-newsletter-hero-{{ ai_gen_id }}__content { padding:{{ block.settings.mobile_padding }}px; } .ai-newsletter-hero-{{ ai_gen_id }}__heading { font-size:{{ block.settings.mobile_heading_size }}px; } }
{% endstyle %}
<newsletter-hero-{{ ai_gen_id }} class="ai-newsletter-hero-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-newsletter-hero-{{ ai_gen_id }}__box">
    <div class="ai-newsletter-hero-{{ ai_gen_id }}__image-wrap">
      {% if block.settings.image != blank %}<img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">{% else %}<div class="ai-newsletter-hero-{{ ai_gen_id }}__placeholder">{{ 'image' | placeholder_svg_tag }}</div>{% endif %}
    </div>
    <div class="ai-newsletter-hero-{{ ai_gen_id }}__content">
      {% if block.settings.eyebrow != blank %}<p class="ai-newsletter-hero-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>{% endif %}
      <h2 class="ai-newsletter-hero-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      <p class="ai-newsletter-hero-{{ ai_gen_id }}__body">{{ block.settings.body }}</p>
      {% form 'customer', id: form_id, class: form_class %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <label for="newsletter-email-{{ ai_gen_id }}" class="visually-hidden">Email address</label>
        <input id="newsletter-email-{{ ai_gen_id }}" class="ai-newsletter-hero-{{ ai_gen_id }}__input" type="email" name="contact[email]" placeholder="{{ block.settings.email_placeholder | escape }}" autocomplete="email" required aria-required="true">
        <button class="ai-newsletter-hero-{{ ai_gen_id }}__button" type="submit">{{ block.settings.button_text }}</button>
        {% if form.posted_successfully? %}<p class="ai-newsletter-hero-{{ ai_gen_id }}__message ai-newsletter-hero-{{ ai_gen_id }}__message--success" role="status">{{ block.settings.success_message }}</p>{% endif %}
        {% if form.errors %}<p class="ai-newsletter-hero-{{ ai_gen_id }}__message ai-newsletter-hero-{{ ai_gen_id }}__message--error" role="alert">{{ form.errors.messages.email }}</p>{% endif %}
      {% endform %}
      <p class="ai-newsletter-hero-{{ ai_gen_id }}__consent">{{ block.settings.consent_note }}</p>
    </div>
  </div>
</newsletter-hero-{{ ai_gen_id }}>
{% schema %}{"name":"Newsletter hero","tag":null,"class":"newsletter-hero-block","settings":[{"type":"header","content":"Content"},{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A free Bible study resource"},{"type":"text","id":"heading","label":"Heading","default":"FREE ROMANS STUDY GUIDE"},{"type":"textarea","id":"body","label":"Body copy","default":"Get the complete chapter-by-chapter guide—verse walkthroughs, historical context, reflection questions, prayer prompts, and space for notes."},{"type":"text","id":"email_placeholder","label":"Email placeholder","default":"Your email address"},{"type":"text","id":"button_text","label":"Button text","default":"Send me the guide"},{"type":"text","id":"success_message","label":"Success message","default":"Check your inbox—the guide is on its way."},{"type":"text","id":"consent_note","label":"Consent note","default":"By signing up, you agree to receive email from Bible House Goods. Unsubscribe anytime."},{"type":"header","content":"Layout"},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100},{"type":"range","id":"content_padding","label":"Content spacing","min":20,"max":80,"step":5,"unit":"px","default":50},{"type":"range","id":"mobile_padding","label":"Mobile spacing","min":16,"max":48,"step":4,"unit":"px","default":28},{"type":"range","id":"content_gap","label":"Element spacing","min":8,"max":32,"step":4,"unit":"px","default":16},{"type":"header","content":"Style"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"serif"},{"type":"font_picker","id":"body_font","label":"Body font","default":"sans-serif"},{"type":"range","id":"heading_size","label":"Heading size","min":28,"max":64,"step":4,"unit":"px","default":48},{"type":"range","id":"mobile_heading_size","label":"Mobile heading size","min":24,"max":44,"step":4,"unit":"px","default":32},{"type":"range","id":"body_size","label":"Body size","min":14,"max":20,"step":1,"unit":"px","default":16},{"type":"range","id":"border_width","label":"Border width","min":2,"max":8,"step":2,"unit":"px","default":4},{"type":"range","id":"shadow_offset","label":"Shadow offset","min":4,"max":16,"step":2,"unit":"px","default":8},{"type":"color","id":"background_color","label":"Background","default":"#EAE0D5"},{"type":"color","id":"border_color","label":"Border","default":"#0A0908"},{"type":"color","id":"shadow_color","label":"Shadow","default":"#E3A72B"},{"type":"color","id":"text_color","label":"Text","default":"#0A0908"},{"type":"color","id":"accent_color","label":"Accent","default":"#5E503F"},{"type":"color","id":"input_color","label":"Input background","default":"#FFFFFF"},{"type":"color","id":"button_color","label":"Button background","default":"#0A0908"},{"type":"color","id":"button_hover_color","label":"Button hover background","default":"#5E503F"},{"type":"color","id":"button_text_color","label":"Button text","default":"#FFFFFF"},{"type":"color","id":"image_placeholder_color","label":"Image placeholder","default":"#C6AC8F"},{"type":"color","id":"muted_color","label":"Muted text","default":"#5E503F"},{"type":"color","id":"success_color","label":"Success text","default":"#245B3A"},{"type":"color","id":"error_color","label":"Error text","default":"#8B1E1E"}],"presets":[{"name":"Newsletter hero"}]}{% endschema %}