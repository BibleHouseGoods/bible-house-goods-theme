{% stylesheet %}
  .hero__content>.hero__copy .button:hover,.hero__content>.hero__copy .button:focus-visible{background:var(--ink);color:var(--cream);box-shadow:5px 5px 0 var(--rust);transform:translate(-2px,-2px)}
  .home-guide-cta{display:flex;justify-content:center;margin-top:36px}
  .hero__scripture{grid-column:2;margin:4px 0 0;padding-top:13px;border-top:1px solid #c8b8a5;color:var(--brown);font-family:var(--font-heading);font-size:clamp(16px,1.6vw,21px);font-style:italic;line-height:1.35}.hero__scripture cite{display:block;margin-top:7px;color:var(--rust);font-family:var(--font-body);font-size:9px;font-style:normal;font-weight:950;letter-spacing:1px;text-transform:uppercase}
  .daily-preview{padding:clamp(75px,9vw,130px) 0;background:var(--cream);color:var(--ink);overflow:hidden}
  .daily-preview__layout{display:grid;grid-template-columns:minmax(0,.85fr) minmax(420px,1.15fr);gap:clamp(50px,8vw,120px);align-items:center}
  .daily-preview__intro .display-title{max-width:720px;margin-bottom:28px;font-size:clamp(50px,6.5vw,96px)}
  .daily-preview__intro>p{max-width:590px;font-size:clamp(17px,1.5vw,20px);line-height:1.7}
  .daily-preview__included{display:flex;flex-wrap:wrap;gap:9px;margin-top:32px}
  .daily-preview__included span{padding:9px 12px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase}
  .daily-preview__device{width:min(100%,520px);justify-self:center;padding:12px;border:2px solid var(--ink);border-radius:34px;background:var(--ink);box-shadow:14px 18px 0 var(--gold)}
  .daily-preview__card{overflow:hidden;background:#fffdf8;border-radius:23px}
  .daily-preview__app-head{display:flex;align-items:center;justify-content:space-between;gap:20px;padding:18px 22px;background:var(--ink);color:var(--cream)}
  .daily-preview__brand{display:flex;align-items:center;gap:9px;font-size:13px;text-transform:uppercase}.daily-preview__brand>span{color:var(--gold);font-size:18px}.daily-preview__day{font-size:9px;font-weight:900;letter-spacing:1px;text-transform:uppercase}
  .daily-preview__progress{height:5px;background:#2c2823}.daily-preview__progress span{display:block;width:56.2%;height:100%;background:var(--gold)}
  .daily-preview__welcome{padding:26px 25px 20px}.daily-preview__welcome>span,.daily-preview__welcome>p{display:block;margin:0;color:var(--rust);font-size:9px;font-weight:950;letter-spacing:1.4px;text-transform:uppercase}.daily-preview__welcome>p{margin-top:6px;color:var(--brown)}.daily-preview__welcome h3{margin:9px 0 0;font-family:var(--font-heading);font-size:clamp(34px,5vw,54px);letter-spacing:-.035em;line-height:.95}
  .daily-preview__verse-card{margin:0 18px;padding:23px;border-radius:16px;background:var(--rust);color:var(--cream)}.daily-preview__label{display:block;color:var(--gold);font-size:9px;font-weight:950;letter-spacing:1.5px;text-transform:uppercase}.daily-preview__verse-card blockquote{margin:12px 0 10px;font-family:var(--font-heading);font-size:clamp(25px,3vw,34px);font-style:italic;line-height:1.12}.daily-preview__verse-card cite{font-size:10px;font-style:normal;font-weight:950;letter-spacing:1px;text-transform:uppercase}
  .daily-preview__section{margin:0 25px;padding:25px 0;border-bottom:1px solid #d9ccbb}.daily-preview__section-head{display:flex;align-items:center;gap:11px}.daily-preview__number{display:flex;width:29px;height:29px;align-items:center;justify-content:center;border:1px solid var(--rust);border-radius:50%;color:var(--rust);font-size:8px;font-weight:950}.daily-preview__section h4{margin:0;font-size:12px;letter-spacing:1.3px;text-transform:uppercase}.daily-preview__section p{margin:13px 0 0;color:#3d372f;font-size:14px;line-height:1.68}.daily-preview__prayer p{font-style:italic}
  .daily-preview__extras{display:grid;gap:9px;padding:20px 18px;background:#f2e7d8}.daily-preview__extra{display:flex;align-items:center;gap:12px;padding:13px 14px;border:1px solid #d4c4b0;border-radius:11px;background:#fffdf8}.daily-preview__extra>span:last-child{display:flex;flex-direction:column;gap:3px}.daily-preview__extra strong{font-size:10px;letter-spacing:.7px;text-transform:uppercase}.daily-preview__extra small{color:var(--brown);font-size:10px}.daily-preview__play,.daily-preview__book{display:flex;width:31px;height:31px;align-items:center;justify-content:center;flex:none;border-radius:50%;background:var(--ink);color:var(--gold);font-size:9px}.daily-preview__book{font-family:var(--font-body);font-size:17px;font-weight:900}
  .daily-preview__card footer{padding:15px 20px;background:var(--ink);color:#c8bfb5;font-size:8px;font-weight:800;letter-spacing:.7px;line-height:1.5;text-transform:uppercase}.daily-preview__cached{display:inline-block;margin-right:8px;padding:4px 6px;border:1px solid var(--gold);color:var(--gold);font-size:7px;letter-spacing:1px}
  @media(max-width:900px){.daily-preview__layout{grid-template-columns:1fr}.daily-preview__device{justify-self:start;margin-right:14px}}
  @media(max-width:640px){.daily-preview__device{padding:8px;border-radius:28px;box-shadow:9px 11px 0 var(--gold)}.daily-preview__card{border-radius:19px}.daily-preview__app-head{padding:16px 18px}.daily-preview__welcome{padding:22px 20px 17px}.daily-preview__section{margin-inline:20px}}
  .home-groups{padding:clamp(75px,9vw,125px) 0;background:var(--rust);color:var(--cream);overflow:hidden}
  .home-groups__inner{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(330px,.85fr);gap:clamp(50px,8vw,120px);align-items:center}
  .home-groups .eyebrow{color:var(--gold)}
  .home-groups .display-title{max-width:850px;font-size:clamp(52px,7.4vw,108px)}
  .home-groups__copy>p{max-width:720px;margin:28px 0 0;font-size:clamp(16px,1.6vw,20px);line-height:1.65}
  .home-groups__actions{display:flex;flex-wrap:wrap;align-items:center;gap:22px;margin-top:34px}
  .home-groups__text-link{font-size:11px;font-weight:900;letter-spacing:1.4px;text-transform:uppercase;text-underline-offset:5px}
  .home-groups__callouts{position:relative;padding:36px;background:var(--cream);color:var(--ink);border:2px solid var(--ink);box-shadow:14px 14px 0 var(--gold);transform:rotate(1deg)}
  .home-groups__ribbon{display:inline-block;margin:-8px 0 25px;padding:8px 11px;background:var(--ink);color:var(--cream);font-size:9px;font-weight:900;letter-spacing:1.7px;text-transform:uppercase}
  .home-groups__badge{display:flex;align-items:center;gap:18px;padding-bottom:26px;border-bottom:2px solid var(--ink)}
  .home-groups__badge strong{color:var(--rust);font-size:68px;letter-spacing:-.06em;line-height:.8}.home-groups__badge span{max-width:130px;font-size:13px;font-weight:950;letter-spacing:1px;line-height:1.1;text-transform:uppercase}
  .home-groups__callouts ul{margin:0;padding:0;list-style:none}.home-groups__callouts li{display:grid;grid-template-columns:36px 1fr;gap:12px;padding:15px 0;border-bottom:1px solid #cfc2b1;font-size:14px;font-weight:900;text-transform:uppercase}.home-groups__callouts li span{color:var(--rust);font-size:10px;letter-spacing:1px}
  .community-proof{padding:clamp(70px,8vw,112px) 0;border-bottom:2px solid #000;background:#f6ecdf;color:#000;font-family:Arial,Helvetica,sans-serif}
  .community-proof *{color:#000;font-family:Arial,Helvetica,sans-serif}
  .community-proof__head{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:40px;align-items:end;margin-bottom:38px}
  .community-proof__head .section-title{max-width:800px}.community-proof__head p{max-width:690px;margin:18px 0 0;color:#000;font-size:17px;line-height:1.65}
  .community-proof__actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:10px}.community-proof__actions a,.social-post__link,.review-card footer a{font-size:10px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase;text-underline-offset:4px}
  .community-proof__actions a{padding:12px 14px;border:1px solid #000;text-decoration:none}.community-proof__actions a:hover{background:#fff}
  .community-proof__rail{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:stretch}
  .social-post,.review-card{min-width:0;border:2px solid #000;background:var(--cream);color:#000;box-shadow:7px 7px 0 var(--gold)}
  .social-post{display:flex;flex-direction:column;text-decoration:none}.social-post__media{position:relative;overflow:hidden;aspect-ratio:4/5;background:var(--ink)}.social-post__media video,.social-post__media img{width:100%;height:100%;object-fit:cover}.social-post__platform{position:absolute;top:10px;left:10px;padding:7px 9px;background:var(--ink);color:var(--cream);font-size:9px;font-weight:950;letter-spacing:1px;text-transform:uppercase}.social-post__placeholder{display:flex;height:100%;align-items:center;justify-content:center;flex-direction:column;gap:12px;background:linear-gradient(150deg,var(--rust),var(--ink));color:var(--cream)}.social-post__placeholder span{display:flex;width:56px;height:56px;align-items:center;justify-content:center;border:2px solid var(--gold);border-radius:50%;font-size:10px;font-weight:900;text-transform:uppercase}.social-post p{margin:0;padding:18px 18px 8px;font-size:14px;font-weight:800;line-height:1.45}.social-post__link{margin-top:auto;padding:0 18px 18px}
  .review-card{display:flex;min-height:360px;flex-direction:column;padding:26px}.review-card__stars{color:#000;font-size:15px;letter-spacing:2px}.review-card blockquote{margin:28px 0;color:#000;font-family:Arial,Helvetica,sans-serif;font-size:clamp(24px,2.3vw,34px);font-weight:800;letter-spacing:-.025em;line-height:1.12;overflow-wrap:anywhere}.review-card footer{display:flex;align-items:flex-start;flex-direction:column;gap:5px;margin-top:auto;padding-top:18px;border-top:1px solid #000}.review-card footer strong{font-size:11px;letter-spacing:1px;text-transform:uppercase}.review-card footer span{color:#000;font-size:11px}
  .review-card--placeholder{align-items:center;justify-content:center;border-style:dashed;background:transparent;box-shadow:none;text-align:center}.review-card--placeholder .review-card__stars{color:#000}.review-card__placeholder-label{margin-top:24px;color:#000;font-size:10px;font-weight:950;letter-spacing:1.4px;text-transform:uppercase}.review-card--placeholder p{max-width:190px;margin:11px 0 0;color:#000;font-size:14px;line-height:1.5}
  @media(max-width:1100px){.community-proof__rail{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:760px){.community-proof__head{grid-template-columns:1fr}.community-proof__actions{justify-content:flex-start;flex-direction:column}.community-proof__actions a{text-align:center}.community-proof__rail{display:grid;width:100%;grid-template-columns:minmax(0,1fr);gap:24px;padding:0;overflow:visible}.social-post,.review-card{width:100%;min-width:0}.review-card{min-height:0;padding:24px}.review-card blockquote{margin:22px 0;font-size:clamp(22px,7vw,30px);line-height:1.2}}
  @media(max-width:900px){.home-groups__inner{grid-template-columns:1fr}.home-groups__callouts{max-width:600px;margin-right:14px}}
  @media(max-width:640px){.home-groups__callouts{padding:27px}.home-groups__actions{align-items:stretch;flex-direction:column}.home-groups__actions .button{width:100%}.home-groups__text-link{padding:8px 0}}
{% endstylesheet %}
