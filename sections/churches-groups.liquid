{% endstylesheet %}
{% javascript %}
function initMinistryPacks(scope) {
  scope.querySelectorAll('[data-ministry-pack]').forEach(root => {
    if (root.dataset.ready) return;
    root.dataset.ready = 'true';
    const form = root.querySelector('[data-pack-form]');
    if (!form) return;
    const inputs = [...form.querySelectorAll('[data-quantity]')];
    const buttons = [...form.querySelectorAll('[data-checkout]')];
    const money = new Intl.NumberFormat(document.documentElement.lang || 'en-US', {style:'currency',currency:root.dataset.currency || 'USD'});
    const tiers = [[250,500],[100,600],[50,800],[25,1000],[10,1200]];
    let locked = false;
    const update = () => {
      let total = 0, preorder = false, valid = true;
      const selection = root.querySelector('[data-selection]');
      selection.replaceChildren();
      inputs.forEach(input => {
        const qty = input.value === '' ? 0 : Number(input.value);
        if (!Number.isSafeInteger(qty) || qty < 0 || !input.validity.valid) { valid = false; return; }
        total += qty;
        if (qty > 0) {
          const li = document.createElement('li');
          li.textContent = qty + ' × ' + input.dataset.title;
          selection.append(li);
          if (input.dataset.tracked && input.dataset.policy === 'continue' && qty > Number(input.dataset.stock)) preorder = true;
        }
      });
      const tier = tiers.find(([minimum]) => total >= minimum);
      const estimate = tier && valid ? money.format(total * tier[1] / 100) : '—';
      root.querySelector('[data-count]').textContent = total;
      root.querySelector('[data-mobile-count]').textContent = total;
      root.querySelector('[data-total]').textContent = estimate;
      root.querySelector('[data-mobile-total]').textContent = estimate;
      root.querySelector('[data-hint]').textContent = !valid ? root.dataset.validation : tier ? money.format(tier[1]/100) + ' × ' + total : root.dataset.minimum;
      root.querySelector('[data-preorder]').hidden = !preorder;
      root.querySelector('[data-mobile-preorder]').hidden = !preorder;
      root.querySelectorAll('[data-tier]').forEach(el => el.classList.toggle('is-active', Boolean(tier && Number(el.dataset.tier) === tier[0])));
      buttons.forEach(button => button.disabled = locked || !valid || total < 10);
      return {valid:valid && total >= 10,items:inputs.filter(input=>Number(input.value)>0).map(input=>({id:Number(input.dataset.variant),quantity:Number(input.value),...(input.dataset.tracked && input.dataset.policy === 'continue' && Number(input.value) > Number(input.dataset.stock) ? {properties:{Ships:root.dataset.preorderNote}} : {})}))};
    };
    inputs.forEach(input=>input.addEventListener('input',update));
    form.addEventListener('submit',async event=>{
      event.preventDefault();
      if (locked) return;
      const order = update();
      if (!order.valid || !form.reportValidity()) return;
      locked = true;
      buttons.forEach(button=>{button.disabled=true;button.textContent=root.dataset.busy;});
      try {
        const response = await fetch(root.dataset.addUrl,{method:'POST',headers:{'Content-Type':'application/json',Accept:'application/json'},body:JSON.stringify({items:order.items})});
        if (!response.ok) throw new Error('cart');
        window.location.assign(root.dataset.cartUrl + '/checkout');
      } catch {
        const error = root.querySelector('[data-error-message]');
        error.textContent = root.dataset.error;
        root.querySelector('[data-review-cart]').hidden = false;
        buttons.forEach(button=>button.textContent=root.dataset.error);
        error.focus();
      }
    });
    update();
  });
}
initMinistryPacks(document);
document.addEventListener('shopify:section:load',event=>initMinistryPacks(event.target));
{% endjavascript %}
