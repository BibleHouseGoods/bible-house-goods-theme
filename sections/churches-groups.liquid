{% liquid
  assign band = all_products['the-bible-band']
  assign colors = band.options_with_values[1].values
%}
<div class="ministry-pack" data-ministry-pack data-add-url="{{ routes.cart_add_url }}.js" data-cart-url="{{ routes.cart_url }}" data-currency="{{ cart.currency.iso_code }}" data-error="{{ 'sections.church_pack.error' | t }}" data-minimum="{{ 'sections.church_pack.minimum' | t }}" data-validation="{{ 'sections.church_pack.validation' | t }}" data-busy="{{ 'sections.church_pack.busy' | t }}" data-band-label="{{ 'sections.church_pack.band' | t }}" data-preorder-note="{{ 'sections.church_pack.mobile_preorder' | t | escape }}">
  <header class="mp-hero page-width">
    <span class="eyebrow">{{ 'sections.church_pack.eyebrow' | t }}</span>
    <h1>{{ 'sections.church_pack.heading' | t }}</h1>
    <p>{{ 'sections.church_pack.intro' | t }}</p>
    <strong>{{ 'sections.church_pack.proof' | t }}</strong>
  </header>
  <section class="page-width mp-order" id="church-inquiry" aria-labelledby="PackHeading-{{ section.id }}">
    <div class="mp-title"><h2 id="PackHeading-{{ section.id }}">{{ 'sections.church_pack.build' | t }}</h2><p>{{ 'sections.church_pack.help' | t }}</p></div>
    <div class="mp-tiers" id="church-pricing" aria-label="{{ 'sections.church_pack.pricing' | t }}">
      {% assign minimums = '10,25,50,100,250' | split: ',' %}
      {% assign ranges = '10–24,25–49,50–99,100–249,250+' | split: ',' %}
      {% assign prices = '1200,1000,800,600,500' | split: ',' %}
      {% for minimum in minimums %}<div data-tier="{{ minimum }}"><span class="mp-tier-quantity">{{ ranges[forloop.index0] }}</span><span>{{ 'sections.church_pack.band' | t }}</span><strong>{{ prices[forloop.index0] | plus: 0 | money }}</strong><small>{{ 'sections.church_pack.each' | t }}</small></div>{% endfor %}
    </div>
    {% if band != blank and band.available %}
      <form class="mp-layout" data-pack-form>
        <div>
          <p class="mp-reversible">{{ 'sections.church_pack.reversible' | t }}</p>
          <div class="mp-colors">
            {% for color in colors %}
              {% liquid
                assign variants = band.variants | where: 'option2', color
                assign first_variant = variants | first
                assign front = first_variant.image
                assign reverse = blank
                assign match = ''
                if color contains 'Field Khaki'
                  assign match = 'Camo.jpg'
                elsif color contains 'Mauve'
                  assign match = 'Cheetah_1'
                elsif color contains 'Cobalt'
                  assign match = 'Grey_Aztec_Main'
                elsif color contains 'Space Grey'
                  assign match = 'Sport_Grey_Main'
                elsif color contains 'Pink Bubblegum'
                  assign match = 'Pink_Check_1'
                elsif color contains 'Maroon'
                  assign match = 'Maroon_2'
                endif
                for photo in band.images
                  if match != blank and photo.src contains match
                    assign reverse = photo
                    break
                  endif
                endfor
                assign image_loading = 'lazy'
                if forloop.first
                  assign image_loading = 'eager'
                endif
              %}
              <fieldset class="mp-card">
                <legend>{{ color | escape }}</legend>
                <div class="mp-photos">
                  {% if front != blank %}{{ front | image_url: width: 360 | image_tag: widths: '180,360', sizes: '(max-width: 600px) 40vw, 180px', loading: image_loading, alt: color }}{% endif %}
                  {% if reverse != blank %}{{ reverse | image_url: width: 360 | image_tag: widths: '180,360', sizes: '(max-width: 600px) 40vw, 180px', loading: image_loading, alt: color }}{% endif %}
                </div>
                <div class="mp-sizes">
                  {% for variant in variants %}
                    <div class="mp-size">
                      <label for="PackQty-{{ section.id }}-{{ variant.id }}"><strong>{{ variant.option1 | split: '—' | first | strip | escape }}</strong><small>{{ variant.option1 | split: '—' | last | strip | escape }}</small></label>
                      <input id="PackQty-{{ section.id }}-{{ variant.id }}" type="number" min="0" step="1" value="0" inputmode="numeric" data-quantity data-variant="{{ variant.id }}" data-title="{{ variant.title | escape }}" data-stock="{{ variant.inventory_quantity | at_least: 0 }}" data-tracked="{{ variant.inventory_management }}" data-policy="{{ variant.inventory_policy }}" {% if variant.inventory_management != blank and variant.inventory_policy == 'deny' %}max="{{ variant.inventory_quantity | at_least: 0 }}"{% endif %} {% unless variant.available %}disabled{% endunless %}>
                      <small class="mp-stock">{% unless variant.available %}{{ 'sections.church_pack.sold_out' | t }}{% else %}{% if variant.inventory_management != blank %}{{ variant.inventory_quantity | at_least: 0 }} {{ 'sections.church_pack.stock' | t }}{% if variant.inventory_policy == 'continue' %} · {{ 'sections.church_pack.preorder_short' | t }}{% endif %}{% else %}{{ 'sections.church_pack.stock' | t }}{% endif %}{% endunless %}</small>
                    </div>
                  {% endfor %}
                </div>
              </fieldset>
            {% endfor %}
          </div>
          <details class="mp-details"><summary>{{ 'sections.church_pack.size_help' | t }}</summary><p>{{ 'sections.church_pack.size_copy' | t }}</p></details>
        </div>
        <aside class="mp-summary" aria-label="{{ 'sections.church_pack.summary' | t }}">
          <h3>{{ 'sections.church_pack.summary' | t }}</h3>
          <div class="mp-total" aria-live="polite"><span>{{ 'sections.church_pack.quantity' | t }} <b data-count>0</b></span><span>{{ 'sections.church_pack.subtotal' | t }} <strong data-total>—</strong></span></div>
          <p data-hint>{{ 'sections.church_pack.minimum' | t }}</p>
          <ul class="mp-selection" data-selection aria-label="{{ 'sections.church_pack.selected' | t }}"></ul>
          <p class="mp-preorder" data-preorder hidden>{{ 'sections.church_pack.preorder' | t }}</p>
          <p>{{ 'sections.church_pack.shipping' | t }}</p>
          <p class="mp-small">{{ 'sections.church_pack.tax' | t }}</p>
          <button class="button button--gold mp-checkout" type="submit" data-checkout disabled>{{ 'sections.church_pack.checkout' | t }}</button>
          <p class="mp-error" data-error-message role="alert" tabindex="-1"></p>
          <a href="{{ routes.cart_url }}" data-review-cart hidden>{{ 'sections.church_pack.cart' | t }}</a>
        </aside>
        <div class="mp-mobile-checkout"><small data-mobile-preorder hidden>{{ 'sections.church_pack.mobile_preorder' | t }}</small><span><b data-mobile-count>0</b> {{ 'sections.church_pack.band' | t }} · <strong data-mobile-total>—</strong></span><button class="button button--gold" type="submit" data-checkout disabled>{{ 'sections.church_pack.checkout' | t }}</button></div>
      </form>
      <noscript><p>{{ 'sections.church_pack.nojs' | t }} <a href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ 'sections.church_pack.contact' | t }}</a></p></noscript>
    {% else %}<p>{{ 'sections.church_pack.unavailable' | t }}</p>{% endif %}
    <a class="mp-small-link" href="{{ band.url | default: '/products/the-bible-band' }}">{{ 'sections.church_pack.small' | t }}</a>
  </section>
  <section class="page-width mp-after">
    <div class="mp-included"><h2>{{ 'sections.church_pack.included' | t }}</h2><p>{{ 'sections.church_pack.included_copy' | t }}</p><a href="https://thebibleband.com/today" target="_blank" rel="noopener">{{ 'sections.church_pack.sample' | t }} ↗</a></div>
    <div class="mp-custom" id="church-custom"><h2>{{ 'sections.church_pack.custom' | t }}</h2><p>{{ 'sections.church_pack.custom_copy' | t }}</p><a href="{{ section.settings.contact_link | default: '/pages/contact' }}">{{ 'sections.church_pack.contact' | t }} →</a></div>
  </section>
  <section class="page-width mp-faq" id="church-faq"><h2>{{ 'sections.church_pack.faq' | t }}</h2>
    <details><summary>{{ 'sections.church_pack.faq1' | t }}</summary><p>{{ 'sections.church_pack.answer1' | t }}</p></details>
    <details><summary>{{ 'sections.church_pack.faq2' | t }}</summary><p>{{ 'sections.church_pack.answer2' | t }}</p></details>
    <details><summary>{{ 'sections.church_pack.faq3' | t }}</summary><p>{{ 'sections.church_pack.answer3' | t }}</p></details>
    <details><summary>{{ 'sections.church_pack.faq4' | t }}</summary><p>{{ 'sections.church_pack.answer4' | t }}</p></details>
  </section>
</div>
{% stylesheet %}
