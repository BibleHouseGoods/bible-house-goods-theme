opacity:.45}.mp-stock{margin-top:4px;color:#555}.mp-summary{position:sticky;top:24px;background:var(--ink,#171713);color:var(--cream,#fffdf8);padding:22px}.mp-summary h3{margin:0 0 20px;font-size:24px;color:inherit}.mp-summary p{font-size:13px;line-height:1.5}.mp-total{display:grid;gap:16px}.mp-total>span{display:flex;justify-content:space-between;align-items:center;gap:15px;font-size:13px}.mp-total strong{font-size:27px;color:var(--gold)}.mp-selection{padding-left:16px;font-size:12px;line-height:1.5;max-height:220px;overflow:auto}.mp-selection li{margin-bottom:7px}.mp-small{opacity:.8;font-size:11px!important}.mp-checkout{width:100%;padding:16px 8px!important}.ministry-pack button:disabled{opacity:.5;cursor:not-allowed}.mp-preorder{padding:12px;background:var(--gold);color:var(--ink)}.mp-error:empty{display:none}.mp-error{color:#ffe0b4}.mp-summary a{color:var(--gold)}.mp-mobile-checkout{display:none}.mp-details,.mp-faq details{border-bottom:1px solid #b5ab9a;padding:16px 0}.ministry-pack summary{cursor:pointer;font-weight:750;line-height:1.4}.ministry-pack details p{line-height:1.65;font-size:14px}.mp-small-link{display:inline-block;margin-top:22px;font-size:12px}.mp-after{display:grid;grid-template-columns:1fr 1fr;gap:30px;padding-top:40px;padding-bottom:32px}.mp-after>div{border-top:3px solid var(--gold);padding-top:16px}.mp-after h2,.mp-faq h2{font-size:25px;margin:0 0 12px}.mp-after p{font-size:14px;line-height:1.65}.mp-after a{font-size:13px;font-weight:800}.mp-faq{max-width:1000px}.ministry-pack [hidden]{display:none!important}.ministry-pack :focus-visible{outline:3px solid var(--rust,#c1440e);outline-offset:3px}
