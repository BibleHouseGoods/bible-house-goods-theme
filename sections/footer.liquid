<footer class="site-footer">
  <div class="page-width footer-grid">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'menu' %}
          <div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading }}</h2><ul class="footer-links">{% for link in block.settings.menu.links %}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{% endfor %}</ul></div>
        {% when 'newsletter' %}
          <div {{ block.shopify_attributes }}><h2 class="footer-title">{{ block.settings.heading }}</h2><p>{{ block.settings.copy }}</p>{% form 'customer', class: 'newsletter' %}<input type="hidden" name="contact[tags]" value="newsletter"><label class="visually-hidden" for="FooterEmail">Email address</label><input id="FooterEmail" type="email" name="contact[email]" placeholder="Email address" required><button type="submit">Join</button>{% if form.posted_successfully? %}<p class="form-success">Thanks—you're on the list.</p>{% endif %}{% endform %}</div>
      {% endcase %}
    {% endfor %}
  </div>
  <section class="footer-disclosure page-width" aria-labelledby="FooterDisclosureTitle">
    <h2 id="FooterDisclosureTitle">{{ 'general.footer.ai_disclosure_title' | t }}</h2>
    <div>
      <p>{{ 'general.footer.ai_disclosure_creation' | t }}</p>
      <p>{{ 'general.footer.ai_disclosure_review' | t }}</p>
      <p><strong>{{ 'general.footer.ai_disclosure_standard' | t }}</strong></p>
    </div>
  </section>
  {% if settings.social_tiktok_url != blank or settings.social_instagram_url != blank or settings.social_etsy_url != blank or settings.social_facebook_url != blank %}
    <nav class="footer-social page-width" aria-label="Follow Bible House Goods">
      <span>Follow along</span>
      {% if settings.social_tiktok_url != blank %}<a href="{{ settings.social_tiktok_url }}" target="_blank" rel="noopener">TikTok ↗</a>{% endif %}
      {% if settings.social_instagram_url != blank %}<a href="{{ settings.social_instagram_url }}" target="_blank" rel="noopener">Instagram ↗</a>{% endif %}
      {% if settings.social_etsy_url != blank %}<a href="{{ settings.social_etsy_url }}" target="_blank" rel="noopener">Etsy ↗</a>{% endif %}
      {% if settings.social_facebook_url != blank %}<a href="{{ settings.social_facebook_url }}" target="_blank" rel="noopener">Facebook ↗</a>{% endif %}
    </nav>
  {% endif %}
  <div class="footer-wordmark page-width">{% if settings.logo != blank %}{{ settings.logo | image_url: width: 1200 | image_tag: widths: '400,800,1200', alt: shop.name }}{% else %}<img src="{{ 'bible-house-logo.png' | asset_url }}" alt="{{ shop.name }}" width="1200" height="400">{% endif %}</div>
  <div class="page-width footer-bottom"><p>© {{ 'now' | date: '%Y' }} Bible House Goods LLC. The Bible Band™. All rights reserved.<small class="footer-content-rights">Original devotional and audio content © {{ 'now' | date: '%Y' }} Clark Whitney. Published by Bible House Goods LLC.</small></p><div>{% for policy in shop.policies %}{% if policy != blank %}<a href="{{ policy.url }}">{{ policy.title }}</a>{% endif %}{% endfor %}<a href="/pages/copyright-permissions">Copyright &amp; Permissions</a></div></div>
</footer>
{% stylesheet %}
  .footer-disclosure{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,1.3fr);gap:clamp(28px,6vw,90px);margin-block:32px;padding:clamp(24px,4vw,42px);border:2px solid #000;background:var(--cream);color:#000;box-shadow:8px 8px 0 var(--gold);font-family:Arial,Helvetica,sans-serif}
  .footer-disclosure h2{margin:0;color:#000;font-family:Arial,Helvetica,sans-serif;font-size:clamp(24px,3vw,40px);font-weight:900;letter-spacing:-.03em;line-height:1;text-transform:uppercase}
  .footer-disclosure p{margin:0 0 16px;color:#000;font-family:Arial,Helvetica,sans-serif;font-size:14px;line-height:1.65}
  .footer-disclosure p:last-child{margin-bottom:0;padding-top:16px;border-top:1px solid #000}
  @media(max-width:760px){.footer-disclosure{grid-template-columns:1fr;margin-block:24px;padding:24px;box-shadow:6px 6px 0 var(--gold)}}
  .footer-content-rights{display:block;margin-top:6px;font-size:12px;line-height:1.5;opacity:.82}
{% endstylesheet %}
{% schema %}
{"name":"Footer","max_blocks":4,"blocks":[{"type":"menu","name":"Menu","settings":[{"type":"text","id":"heading","label":"Heading","default":"Explore"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]},{"type":"newsletter","name":"Newsletter","settings":[{"type":"text","id":"heading","label":"Heading","default":"Join our email list"},{"type":"textarea","id":"copy","label":"Text","default":"Get exclusive deals and early access to new products."}]}],"presets":[{"name":"Footer","blocks":[{"type":"menu","settings":{"heading":"Shop"}},{"type":"menu","settings":{"heading":"Learn"}},{"type":"menu","settings":{"heading":"Support"}},{"type":"newsletter"}]}]}
{% endschema %}