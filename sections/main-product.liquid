{% liquid
  assign is_bible_band = false
  if product.handle == 'the-bible-band'
    assign is_bible_band = true
  endif
  assign current = product.selected_or_first_available_variant
  assign product_form_id = 'ProductForm-' | append: section.id
  assign gift_ready_product = all_products['gift-ready-packaging']
  assign gift_ready_variant = gift_ready_product.selected_or_first_available_variant
  assign gallery_limit = 8
  assign gallery_count = product.media.size | at_most: gallery_limit
  assign color_extra_count = 0
  if is_bible_band
    for v in product.variants
      if v.option1 contains 'Medium' and v.featured_media != blank and v.featured_media.position > gallery_limit and v.featured_media.media_type == 'image'
        assign color_extra_count = color_extra_count | plus: 1
      endif
    endfor
  endif
  assign gallery_count = gallery_count | plus: color_extra_count
  assign demo_media = blank
  for media in product.media
    if media.media_type == 'video' or media.media_type == 'external_video'
      assign demo_media = media
      break
    endif
  endfor
  assign size_option = blank
  assign color_option = blank
  for opt in product.options_with_values
    if opt.name == 'Size'
      assign size_option = opt
    endif
    if opt.name == 'Color'
      assign color_option = opt
    endif
  endfor
  assign use_band_options = false
  if is_bible_band and size_option != blank and color_option != blank
    assign use_band_options = true
  endif
%}
<section class="product-page page-width{% if is_bible_band %} product-page--bible-band{% endif %}">
  <div class="product-layout">
    <div class="product-media-column">
      <div class="product-gallery-wrap" data-product-gallery>
        <div class="product-gallery" data-product-gallery-track>
          {% for media in product.media limit: gallery_limit %}
            <div class="product-gallery__item" data-product-gallery-slide data-media-id="{{ media.id }}">
              {% if media.media_type == 'image' %}
                {% if forloop.first %}
                  {{ media | image_url: width: 1600 | image_tag: widths: '400,700,1000,1600', sizes: '(min-width: 1001px) min(55vw, 760px), 100vw', loading: 'eager', fetchpriority: 'high', alt: media.alt | default: product.title }}
                {% else %}
                  {{ media | image_url: width: 1600 | image_tag: widths: '400,700,1000,1600', sizes: '(min-width: 1001px) min(55vw, 760px), 100vw', loading: 'lazy', alt: media.alt | default: product.title }}
                {% endif %}
              {% else %}
                {% if is_bible_band and forloop.first and media.media_type == 'video' %}
                  {{ media | media_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata' }}
                {% else %}
                  {{ media | media_tag: image_size: '1600x' }}
                {% endif %}
              {% endif %}
            </div>
          {% else %}
            {{ 'product-1' | placeholder_svg_tag }}
          {% endfor %}
          {%- if is_bible_band -%}
            {%- comment -%} One extra slide per color whose photo is not already in the first {{ gallery_limit }} slides. The color swatches jump to these. {%- endcomment -%}
            {%- for v in product.variants -%}
              {%- if v.option1 contains 'Medium' and v.featured_media != blank and v.featured_media.position > gallery_limit and v.featured_media.media_type == 'image' -%}
                {%- assign color_slide_alt = v.featured_media.alt | default: v.option2 -%}
                <div class="product-gallery__item" data-product-gallery-slide data-media-id="{{ v.featured_media.id }}">
                  {{ v.featured_media | image_url: width: 1600 | image_tag: widths: '400,700,1000,1600', sizes: '(min-width: 1001px) min(55vw, 760px), 100vw', loading: 'lazy', alt: color_slide_alt }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </div>
        {% if gallery_count > 1 %}
          <div class="product-gallery__controls">
            <button class="product-gallery__button" type="button" data-gallery-previous aria-label="{{ 'products.gallery.previous' | t }}">&larr;</button>
            <p class="product-gallery__counter" aria-live="polite"><span data-gallery-current>1</span> / {{ gallery_count }}</p>
            <button class="product-gallery__button" type="button" data-gallery-next aria-label="{{ 'products.gallery.next' | t }}">&rarr;</button>
          </div>
        {% endif %}
      </div>
      <div class="product-details">
        {% if is_bible_band %}
          <div class="band-at-a-glance">
            <span class="eyebrow">{{ 'products.bible_band.at_a_glance' | t }}</span>
            <div class="band-at-a-glance__items" aria-label="{{ 'products.bible_band.included_label' | t }}">
              <span>{{ 'products.bible_band.scripture_label' | t }}</span><span>{{ 'products.bible_band.devotion_label' | t }}</span><span>{{ 'products.bible_band.prayer_label' | t }}</span><span>{{ 'products.bible_band.audio_label' | t }}</span><span>{{ 'products.bible_band.plan_label' | t }}</span>
            </div>
          </div>
          <div class="product-meta">
            <details><summary>{{ 'products.bible_band.details_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.details_copy' | t }}</p></div></details>
            <details><summary>{{ 'products.bible_band.compatibility_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.compatibility_copy' | t }}</p></div></details>
            <details><summary>{{ 'products.bible_band.shipping_heading' | t }}</summary><div class="rte"><p>{{ 'products.bible_band.shipping_copy' | t }}</p></div></details>
          </div>
        {% else %}
          <div class="rte">{{ product.description }}</div>
          <div class="product-meta"><details><summary>Shipping &amp; delivery</summary><div class="rte"><p>Shipping and delivery options are shown at checkout. Digital products are delivered according to their product description.</p></div></details><details><summary>Questions?</summary><div class="rte"><p>Visit our FAQ or contact Bible House Goods and we'll be glad to help.</p></div></details></div>
        {% endif %}
      </div>
      {% if is_bible_band %}
        {% render 'featured-bible-band-reviews', product: product, section: section %}
      {% endif %}
    </div>
    <div class="product-info">
      {% if product.vendor != blank %}<span class="eyebrow">{{ product.vendor }}</span>{% endif %}
      <h1>{% if is_bible_band %}{{ 'products.bible_band.short_title' | t }}{% else %}{% render 'trademark-title', title: product.title %}{% endif %}</h1>
      {% if is_bible_band %}
        <p class="band-benefit-copy">{{ 'products.bible_band.mobile_benefit' | t }}</p>
      {% endif %}
      <div class="product-rating-summary">
        {% render 'judgeme-star-rating', product: product %}
        <a href="#judgeme_product_reviews">{{ 'general.social_proof.judgeme_link' | t }}</a>
      </div>
      <p class="product-price" data-product-price>{{ current.price | money }}</p>
      {% if is_bible_band %}
        <div class="product-quick-proof" aria-label="Bible Band purchase benefits">
          <span>No app</span><span>No subscription</span><span>Free shipping</span>
        </div>
      {% endif %}
      {% if settings.social_etsy_url != blank and is_bible_band == false %}
        <a class="product-review-link" href="{{ settings.social_etsy_url }}" target="_blank" rel="noopener"><span aria-hidden="true">★★★★★</span> Read customer reviews on Etsy ↗</a>
      {% endif %}
      {% if is_bible_band and section.settings.show_demo_video and demo_media == blank %}
        <aside class="tap-demo tap-demo--early tap-demo--hero" aria-labelledby="TapDemoTitle-{{ section.id }}">
          <div class="tap-demo__heading">
            <span class="eyebrow">{{ 'products.bible_band.tap_demo_heading' | t }}</span>
            <h2 id="TapDemoTitle-{{ section.id }}">{{ section.settings.problem_heading }}</h2>
            <p>{{ section.settings.problem_copy }}</p>
          </div>
          <div class="tap-demo__media" data-tap-demo data-demo-duration="5">
            {% if section.settings.demo_video != blank %}
              {{ section.settings.demo_video | video_tag: autoplay: true, loop: true, muted: true, controls: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
            {% elsif demo_media != blank %}
              {{ demo_media | media_tag: autoplay: true, loop: true, muted: true, controls: true }}
            {% else %}
              <div class="tap-demo__placeholder"><span>{{ 'products.bible_band.tap_demo_tap' | t }}</span><strong>{{ 'products.bible_band.tap_demo_scripture' | t }}</strong><small>{{ 'products.bible_band.tap_demo_no_app' | t }}</small></div>
            {% endif %}
          </div>
        </aside>
      {% endif %}
      {% form 'product', product, id: product_form_id, class: 'product-form', data-product-form: '' %}
        <input type="hidden" name="id" value="{{ current.id }}">
        {% unless product.has_only_default_variant %}
          {% if use_band_options %}
            {% render 'band-pack-builder', product: product, section: section, current: current, size_option: size_option, color_option: color_option %}
          {% endif %}
          <div class="band-legacy-select{% if use_band_options %} visually-hidden{% endif %}">
            <label class="field-label{% if is_bible_band %} field-label--band-choice{% endif %}" for="Variant-{{ section.id }}">
              {% if is_bible_band %}{{ 'products.bible_band.choose_band' | t }}{% else %}Choose an option{% endif %}
            </label>
            <select id="Variant-{{ section.id }}" data-variant-select data-product-title="{{ product.title | escape }}">{% for variant in product.variants %}<option value="{{ variant.id }}" data-available="{{ variant.available }}" data-media-id="{{ variant.featured_media.id }}" data-price="{{ variant.price | money }}" data-variant-title="{{ variant.title | escape }}"{% if variant.id == current.id %} selected{% endif %}>{{ variant.title }}{% unless variant.available %} — Sold out{% endunless %}</option>{% endfor %}</select>
          </div>
          {% if use_band_options %}<noscript><style>.band-options{display:none !important}.band-legacy-select.visually-hidden{position:static !important;width:auto !important;height:auto !important;margin:0 !important;clip:auto !important;clip-path:none !important;overflow:visible !important;white-space:normal !important}</style></noscript>{% endif %}
        {% endunless %}
        {% if is_bible_band and use_band_options == false %}
          <aside class="size-guidance" aria-label="Bible Band size guidance">
            <strong>Not sure which size to choose?</strong>
            <p><strong>Youth / Small</strong> — 160mm (6.3") · <strong>Medium</strong> — 180mm (7.1") · <strong>Large</strong> — 195mm (7.7") · <strong>XL</strong> — 205mm (8.1")</p>
            <small>Measure snugly around your wrist. If you’re between sizes, size up.</small>
          </aside>
        {% endif %}
        {% if is_bible_band and gift_ready_product != blank and gift_ready_variant.available %}
          <aside class="product-gift-ready" data-product-gift-ready{% if gift_ready_product.featured_media == blank %} style="grid-template-columns:1fr"{% endif %}>
            {%- if gift_ready_product.featured_media != blank -%}
              <img src="{{ gift_ready_product.featured_media | image_url: width: 264 }}" alt="Bible House Goods gift-ready stamped kraft sack with a Bible Band and gift tag" width="900" height="1600" loading="lazy">
            {%- endif -%}
            <label>
              <input type="checkbox" value="{{ gift_ready_variant.id }}" data-gift-ready-variant>
              <span><strong>Make it gift-ready — {{ gift_ready_variant.price | money }}</strong><small>Stamped kraft sack, colored raffia, and a gift tag—ready for you to give.</small></span>
            </label>
            <p class="product-gift-ready__status" data-gift-ready-status role="alert" aria-live="polite"></p>
          </aside>
        {% endif %}
        {% if is_bible_band %}
          <input id="Quantity-{{ section.id }}" type="hidden" name="quantity" value="1" data-band-quantity>
        {% else %}
          <div><label class="field-label" for="Quantity-{{ section.id }}">Quantity</label><input id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1"></div>
        {% endif %}
        {% if use_band_options %}<p class="band-order-summary" data-band-order-summary aria-live="polite"></p>{% endif %}
        <button class="button" type="submit" data-primary-product-submit data-product-title="{{ product.title | escape }}"{% unless current.available %} disabled{% endunless %}>{% if current.available %}Add to cart{% else %}Sold out{% endif %}</button>
        {% if is_bible_band %}{% render 'buy-box-notes', section: section %}{% endif %}
        {{ form | payment_button }}
        {% render 'payment-options' %}
        {%- if is_bible_band and section.settings.mark_testimonial_quote != blank -%}
          {%- comment -%} Compact version of the Mark Hatley story, right under the payment buttons. The full story is further down the page. {%- endcomment -%}
          {%- assign mark_short = section.settings.mark_testimonial_quote | split: '…' | first | strip | truncate: 170 -%}
          <aside class="mark-card" aria-label="{{ 'products.bible_band.customer_story' | t }}">
            <div class="mark-card__photo">
              {%- if section.settings.mark_testimonial_image != blank -%}
                {{ section.settings.mark_testimonial_image | image_url: width: 160 | image_tag: widths: '80,160', sizes: '64px', loading: 'lazy', alt: section.settings.mark_testimonial_name }}
              {%- else -%}
                <img src="https://cdn.shopify.com/s/files/1/0966/1972/4984/files/mark-hatley-bible-band-testimonial.jpg?v=1785633674&width=160" width="64" height="64" loading="lazy" alt="{{ section.settings.mark_testimonial_name | escape }}">
              {%- endif -%}
            </div>
            <div class="mark-card__body">
              <span class="mark-card__stars" aria-label="5 out of 5 stars">★★★★★</span>
              <blockquote>“{{ mark_short }}”</blockquote>
              <p class="mark-card__by"><strong>{{ section.settings.mark_testimonial_name }}</strong>{% if section.settings.mark_testimonial_location != blank %}, {{ section.settings.mark_testimonial_location }}{% endif %} · <a href="#MarkTestimonial-{{ section.id }}">Read the full story ↓</a></p>
            </div>
          </aside>
        {%- endif -%}
        {% if is_bible_band %}
          <ul class="purchase-reassurance" aria-label="Purchase reassurance">
            <li><strong>Free shipping</strong><span>on Bible Band orders</span></li>
            <li><strong>No app</strong><span>tap and open</span></li>
            <li><strong>No subscription</strong><span>ever</span></li>
            <li><strong>Compatible</strong><span>iPhone &amp; Android</span></li>
            <li><strong>Delivery</strong><span data-delivery-reassurance>{{ 'products.bible_band.delivery_estimate' | t }}</span></li>
            <li><strong>Easy returns</strong><span>{% if shop.refund_policy != blank %}<a href="{{ shop.refund_policy.url }}">View return policy</a>{% else %}Contact us for help{% endif %}</span></li>
          </ul>
          <p class="product-impact"><span aria-hidden="true">✦</span><strong>Your Bible Band™ gives back.</strong> A portion of all profits supports local church ministry and missions.</p>
        {% endif %}
      {% endform %}
      {% if is_bible_band and section.settings.show_gift_block %}
        <aside class="gift-callout">
          <span class="gift-callout__tag">{{ section.settings.gift_heading }}</span>
          <p>{{ section.settings.gift_copy }}</p>
        </aside>
      {% endif %}
      {% if section.settings.enable_social_share and is_bible_band == false %}{% render 'product-share', product: product, share_url: canonical_url %}{% endif %}
    </div>
  </div>
</section>

{% if is_bible_band %}
  <section class="mark-testimonial" aria-labelledby="MarkTestimonial-{{ section.id }}">
    <div class="page-width mark-testimonial__layout">
      <div class="mark-testimonial__image">
        {% if section.settings.mark_testimonial_image != blank %}
          {{ section.settings.mark_testimonial_image | image_url: width: 1200 | image_tag: widths: '360,560,760,1000,1200', sizes: '(min-width: 901px) 40vw, (min-width: 641px) 560px, 100vw', loading: 'lazy', alt: section.settings.mark_testimonial_name }}
        {% else %}
          <img src="https://cdn.shopify.com/s/files/1/0966/1972/4984/files/mark-hatley-bible-band-testimonial.jpg?v=1785633674" loading="lazy" width="960" height="960" alt="{{ section.settings.mark_testimonial_name | escape }}">
        {% endif %}
      </div>
      <div class="mark-testimonial__copy">
        <span class="eyebrow">{{ 'products.bible_band.customer_story' | t }}</span>
        <span class="mark-testimonial__stars" aria-label="5 out of 5 stars">★★★★★</span>
        <blockquote id="MarkTestimonial-{{ section.id }}">“{{ section.settings.mark_testimonial_quote }}”</blockquote>
        <p class="mark-testimonial__person"><strong>{{ section.settings.mark_testimonial_name }}</strong><span>{{ section.settings.mark_testimonial_location }}</span></p>
        <a href="#judgeme_product_reviews">{{ 'products.bible_band.full_testimonial_link' | t }} ↓</a>
      </div>
    </div>
  </section>
{% endif %}

<div class="mobile-purchase-bar" data-mobile-purchase-bar>
  <div>
    <strong data-sticky-selection>{% if is_bible_band %}The Bible Band™{% else %}{{ product.title }}{% endif %}</strong>
    <span data-sticky-price>{{ current.price | money }}</span>
  </div>
  <button class="button button--gold" type="button" data-sticky-add{% if is_bible_band %} data-action="choose"{% endif %} aria-controls="{{ product_form_id }}"{% unless current.available %} disabled{% endunless %}>
    {% if current.available %}{% if is_bible_band %}{{ 'products.bible_band.choose_my_band' | t }}{% else %}Add to Cart{% endif %}{% else %}Sold out{% endif %}
  </button>
</div>

{% if product.handle == 'the-bible-band' and section.settings.show_bible_band_sections %}
  <section class="dark-section">
    <div class="page-width">
      <span class="eyebrow">{{ 'products.bible_band.how_it_works' | t }}</span>
      <h2 class="section-title">{{ 'products.bible_band.discipleship_title' | t }}</h2>
      <div class="steps-grid">
        <div class="step"><div class="step__number">1</div><h3>{{ 'products.bible_band.wear_title' | t }}</h3><p>{{ 'products.bible_band.wear_copy' | t }}</p></div>
        <div class="step"><div class="step__number">2</div><h3>{{ 'products.bible_band.tap_title' | t }}</h3><p>{{ 'products.bible_band.tap_copy' | t }}</p></div>
        <div class="step"><div class="step__number">3</div><h3>{{ 'products.bible_band.read_title' | t }}</h3><p>{{ 'products.bible_band.read_copy' | t }}</p></div>
      </div>
    </div>
  </section>

  <section class="daily-preview" aria-labelledby="ProductDailyPreview-{{ section.id }}">
    <div class="page-width daily-preview__layout">
      <div class="daily-preview__intro">
        <span class="eyebrow">{{ section.settings.sample_kicker }}</span>
        <h2 class="display-title" id="ProductDailyPreview-{{ section.id }}">{{ section.settings.sample_heading }}</h2>
        <p>{{ section.settings.sample_intro }}</p>
        <div class="daily-preview__included" aria-label="{{ 'products.bible_band.included_label' | t }}">
          <span>{{ 'products.bible_band.scripture_label' | t }}</span><span>{{ 'products.bible_band.devotion_label' | t }}</span><span>{{ 'products.bible_band.prayer_label' | t }}</span><span>{{ 'products.bible_band.audio_label' | t }}</span><span>{{ 'products.bible_band.plan_label' | t }}</span>
        </div>
        <a class="button" href="https://thebibleband.com/today" target="_blank" rel="noopener">{{ 'products.bible_band.preview_button' | t }} ↗</a>
      </div>
      <div class="daily-preview__device">
        <video controls playsinline preload="none" poster="https://cdn.shopify.com/s/files/1/0966/1972/4984/files/bible-band-real-sample-day-poster.jpg?v=1785634132" aria-label="{{ 'products.bible_band.sample_video_label' | t }}">
          <source src="{{ 'bible-band-sample-day.mp4' | asset_url }}" type="video/mp4">
          <a href="https://thebibleband.com/today" target="_blank" rel="noopener">{{ 'products.bible_band.preview_button' | t }}</a>
        </video>
      </div>
    </div>
  </section>

  <section class="product-guide-band">
    <div class="page-width">
      {% render 'band-guide-callout', variant: 'wide' %}
    </div>
  </section>
{% endif %}

{% render 'judgeme-review-widget', product: product %}

{% schema %}
{
  "name": "Product information",
  "settings": [
    { "type": "checkbox", "id": "show_bible_band_sections", "label": "Show Bible Band discipleship sections", "default": true },
    { "type": "header", "content": "Pack builder" },
    { "type": "text", "id": "mix_note", "label": "Mix and match note", "default": "Mix any sizes and colors — your discount applies automatically." },
    { "type": "header", "content": "Incoming stock" },
    { "type": "textarea", "id": "next_batch_message", "label": "Next batch message", "info": "Shown after the automatic stock count in Almost gone. Update for each shipment, or leave blank to hide the batch message." },
    { "type": "header", "content": "Preorder" },
    { "type": "text", "id": "preorder_label", "label": "Preorder label", "default": "Preorder" },
    { "type": "text", "id": "preorder_note", "label": "Short ship estimate", "default": "expected to ship in 3–4 weeks" },
    { "type": "textarea", "id": "preorder_copy", "label": "Preorder explanation", "default": "This band is on the way. Order now and it is expected to ship in 3–4 weeks. If your pack mixes preorder and in-stock bands, the whole order ships together when all bands are ready. Need it sooner? Choose a size and style marked “Ships now.”" },
    { "type": "header", "content": "Sizing guidance" },
    { "type": "text", "id": "fit_kids", "label": "Kids fit range", "default": "Fits most wrists about 5.5–6.5 in" },
    { "type": "text", "id": "fit_adult", "label": "Adult fit range", "default": "Fits most wrists about 6.5–7.5 in" },
    { "type": "text", "id": "fit_adult_xl", "label": "Adult XL fit range", "default": "Fits most wrists about 7.5–8.5 in" },
    { "type": "text", "id": "size_help_link", "label": "Sizing help link text", "default": "Not sure which size? Measure in 10 seconds →" },
    { "type": "textarea", "id": "size_help_copy", "label": "Sizing help copy", "default": "Most adults should choose Adult. Choose Adult XL if standard watch bands usually feel tight or you regularly need extended-length bands. If you’re between sizes, size up. For the best fit, wrap a strip of paper snugly around your wrist, mark where it overlaps, then lay it flat against a ruler." },
    { "type": "text", "id": "reversible_note", "label": "Reversible note", "default": "Every band is reversible — a solid side and a patterned side, so each color is really two." },
    { "type": "header", "content": "Delivery estimate" },
    { "type": "checkbox", "id": "show_delivery_date", "label": "Show estimated delivery dates under Add to Cart", "default": true },
    { "type": "range", "id": "delivery_processing_min", "label": "Processing days, fastest", "min": 0, "max": 10, "step": 1, "unit": "d", "default": 1 },
    { "type": "range", "id": "delivery_processing_max", "label": "Processing days, slowest", "min": 0, "max": 10, "step": 1, "unit": "d", "default": 3 },
    { "type": "range", "id": "delivery_shipping_min", "label": "Shipping days, fastest", "min": 1, "max": 20, "step": 1, "unit": "d", "default": 5 },
    { "type": "range", "id": "delivery_shipping_max", "label": "Shipping days, slowest", "min": 1, "max": 20, "step": 1, "unit": "d", "default": 10, "info": "All four numbers are business days. Dates skip weekends but not holidays." },
    { "type": "header", "content": "Compatibility line" },
    { "type": "text", "id": "compat_line", "label": "One-line compatibility note under Add to Cart", "default": "Works with iPhone XS and newer and most NFC-enabled Android phones. No app needed.", "info": "Leave blank to hide it." },
    { "type": "header", "content": "Buy box order (test)" },
    { "type": "select", "id": "buybox_order", "label": "Order of the buying steps", "options": [ { "value": "pack_first", "label": "Pack, size, color (current)" }, { "value": "color_first", "label": "Color, size, then pack (test)" } ], "default": "pack_first", "info": "You can also preview the test order on any product link by adding ?buybox=color-first to the URL." },
    { "type": "header", "content": "Gift callout" },
    { "type": "checkbox", "id": "show_gift_block", "label": "Show gift callout", "default": true },
