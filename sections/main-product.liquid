{% stylesheet %}
  .featured-reviews{padding:clamp(64px,8vw,110px) 0;background:var(--tan);color:var(--ink)}.featured-reviews--column{margin-top:34px;padding:34px 26px;border:2px solid var(--ink)}
  .featured-reviews__head{display:flex;align-items:end;justify-content:space-between;gap:30px;margin-bottom:34px}.featured-reviews__head h2{margin:8px 0 0;font-size:clamp(40px,6vw,78px);letter-spacing:-.05em;line-height:.92;text-transform:uppercase}.featured-reviews--column .featured-reviews__head{display:grid;gap:14px}.featured-reviews--column .featured-reviews__head h2{font-size:clamp(34px,4vw,56px)}
  .featured-reviews__grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.featured-review{display:flex;min-width:0;flex-direction:column;background:var(--cream);border:2px solid var(--ink)}.featured-review__image{position:relative;overflow:hidden;aspect-ratio:4/3;background:var(--brown)}.featured-review__image img{width:100%;height:100%;object-fit:cover}.featured-review__image>span{position:absolute;right:8px;bottom:8px;padding:6px 8px;background:var(--ink);color:var(--cream);font-size:8px;font-weight:900;letter-spacing:1px;text-transform:uppercase}.featured-review__copy{display:flex;flex:1;flex-direction:column;padding:22px}.featured-review__copy>span{color:var(--rust);font-size:13px;letter-spacing:2px}.featured-review blockquote{margin:12px 0 20px;font-size:16px;font-weight:750;line-height:1.55}.featured-review cite{margin-top:auto;font-size:10px;font-style:normal;font-weight:900;letter-spacing:1px;text-transform:uppercase}.featured-reviews__link{display:inline-block;margin-top:24px;font-size:11px;font-weight:950;letter-spacing:1px;text-transform:uppercase;text-underline-offset:5px}
  .band-at-a-glance{padding-top:22px}.band-at-a-glance__items{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}.band-at-a-glance__items span{padding:9px 11px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1px;text-transform:uppercase}
  .gift-callout{margin:26px 0 0;padding:16px 18px;border:2px solid var(--ink);background:var(--tan)}.gift-callout__tag{display:block;margin-bottom:6px;font-size:10px;font-weight:950;letter-spacing:1.4px;text-transform:uppercase}.gift-callout p{margin:0;font-size:15px;line-height:1.55}
  .band-options{display:grid;gap:24px;margin-bottom:8px}.band-option{margin:0;padding:0;border:0}.product-page .product-media-column{padding-top:18px}.product-page--bible-band .product-gallery__item:first-child video{display:block;width:100%!important;height:auto!important;max-height:none!important;aspect-ratio:1/1!important;object-fit:contain!important;object-position:center top!important;background:var(--tan)}.band-option>.field-label{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;width:100%;box-sizing:border-box;margin:0 0 14px;padding:12px 14px;border:2px solid var(--ink);border-radius:4px;background:var(--ink);color:var(--cream);font-size:17px;line-height:1.2;font-weight:950;letter-spacing:.4px;box-shadow:4px 4px 0 rgba(0,0,0,.12)}.band-option__selected{font-size:12px;font-weight:750;letter-spacing:0;text-transform:none;opacity:.75}
  .band-sizes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
  .band-size{display:flex;flex-direction:column;gap:4px;padding:12px 10px;border:2px solid var(--ink);background:var(--cream);color:var(--ink);text-align:left;cursor:pointer;transition:background .15s ease,color .15s ease}
  .band-size strong{font-size:14px;font-weight:900;letter-spacing:.3px}.band-size small{font-size:10px;line-height:1.35;opacity:.75}
  .band-size[aria-pressed="true"]{background:var(--ink);color:var(--cream);box-shadow:4px 4px 0 var(--gold)}.band-size[aria-pressed="true"] small{opacity:.9}
  .band-size-help__toggle{margin-top:10px;padding:0;border:0;background:none;color:var(--ink);font-size:11px;font-weight:900;letter-spacing:.6px;text-decoration:underline;text-underline-offset:4px;cursor:pointer}
  .band-size-help{margin-top:12px;padding:14px 16px;border:1px dashed var(--ink);background:var(--cream)}.band-size-help p{margin:0 0 10px;font-size:13px;line-height:1.55}.band-size-help ul{margin:0;padding:0;list-style:none;display:grid;gap:8px}.band-size-help li{display:grid;gap:2px;font-size:12px}.band-size-help li strong{font-size:11px;font-weight:950;letter-spacing:1px;text-transform:uppercase}.band-size-help li em{font-style:normal;font-size:11px;opacity:.65}
  .band-swatches{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}
  .band-swatch{display:flex;flex-direction:column;gap:6px;padding:6px;border:2px solid var(--ink);background:var(--cream);color:var(--ink);cursor:pointer;transition:box-shadow .15s ease,transform .15s ease}
  .band-swatch__media{display:block;overflow:hidden;aspect-ratio:1/1;background:var(--tan)}.band-swatch__media img{width:100%;height:100%;object-fit:cover;display:block}
  .band-swatch__name{display:block;font-size:9px;font-weight:900;letter-spacing:.2px;line-height:1.3;text-align:center;text-wrap:balance}
  .band-swatch__name i{display:inline-block;margin:0 2px;font-style:normal;opacity:.45}
  .band-swatch[aria-pressed="true"]{box-shadow:4px 4px 0 var(--gold);transform:translate(-1px,-1px)}
  .band-swatch.is-unavailable{opacity:.4}.band-swatch.is-unavailable .band-swatch__media img{filter:grayscale(1)}
  .band-swatches__note{margin:10px 0 0;font-size:11px;line-height:1.5;opacity:.7}
  .product-form .purchase-reassurance{margin-top:22px}
  .quiet-time-solution{margin-top:30px}
  @media(max-width:480px){.band-sizes{grid-template-columns:1fr}.band-swatches{grid-template-columns:repeat(2,1fr)}.band-swatch__name{font-size:10px}}
  .mark-testimonial{padding:clamp(58px,7vw,96px) 0;background:var(--ink);color:var(--cream);border-block:2px solid var(--ink)}.mark-testimonial__layout{display:grid;grid-template-columns:minmax(300px,.72fr) minmax(0,1.28fr);gap:clamp(34px,7vw,96px);align-items:center}.mark-testimonial__image{overflow:hidden;aspect-ratio:1/1;border:2px solid var(--gold);box-shadow:12px 12px 0 var(--rust)}.mark-testimonial__image img{width:100%;height:100%;object-fit:cover}.mark-testimonial__copy .eyebrow{color:var(--gold)}.mark-testimonial__stars{display:block;color:var(--gold);font-size:16px;letter-spacing:3px}.mark-testimonial blockquote{max-width:850px;margin:18px 0 26px;font-family:var(--font-heading);font-size:clamp(27px,3.2vw,48px);font-weight:850;letter-spacing:-.035em;line-height:1.08}.mark-testimonial__person{display:flex;flex-direction:column;gap:5px;margin:0}.mark-testimonial__person strong{font-size:14px;letter-spacing:1px;text-transform:uppercase}.mark-testimonial__person span{color:var(--tan);font-size:12px}.mark-testimonial__copy>a{display:inline-block;margin-top:24px;color:var(--gold);font-size:10px;font-weight:950;letter-spacing:1px;text-transform:uppercase;text-underline-offset:5px}
  .product-guide-band{padding:0 0 clamp(48px,6vw,80px);background:var(--cream)}
  .daily-preview{padding:clamp(64px,8vw,100px) 0 clamp(40px,5vw,64px);background:var(--cream);color:var(--ink);overflow:hidden}
  .daily-preview__layout{display:grid;grid-template-columns:minmax(0,.8fr) minmax(380px,1.2fr);gap:clamp(42px,7vw,100px);align-items:center}
  .daily-preview__intro .display-title{max-width:620px;margin-bottom:22px;font-size:clamp(46px,6vw,82px)}.daily-preview__intro>p{max-width:520px;font-size:18px;line-height:1.65}
  .daily-preview__included{display:flex;flex-wrap:wrap;gap:9px;margin-top:28px}.daily-preview__included span{padding:9px 12px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:1.2px;text-transform:uppercase}.daily-preview__intro .button{margin-top:26px}
  .daily-preview__device{width:min(100%,680px);justify-self:center}.daily-preview__device video{display:block;width:100%;max-height:760px;aspect-ratio:720/1564;object-fit:cover;border:2px solid var(--ink);background:var(--ink);box-shadow:12px 14px 0 var(--gold)}
  @media(max-width:900px){.featured-reviews__grid{grid-template-columns:1fr 1fr}.featured-review:last-child{grid-column:1/-1}.mark-testimonial__layout,.daily-preview__layout{grid-template-columns:1fr}.mark-testimonial__image{width:min(100%,560px)}.daily-preview__device{justify-self:start;margin-right:14px}}
  @media(max-width:640px){.featured-reviews{padding-block:54px}.featured-reviews--column{margin-top:0;padding:28px 18px}.featured-reviews__head{display:grid;margin-bottom:24px}.featured-reviews__grid{display:flex;margin-right:-18px;overflow-x:auto;scroll-snap-type:x mandatory;padding-right:18px}.featured-review{min-width:78vw;scroll-snap-align:start}.featured-review:last-child{grid-column:auto}.featured-review__copy{padding:18px}.featured-review blockquote{font-size:14px}.mark-testimonial{padding-block:48px}.mark-testimonial__layout{gap:32px}.mark-testimonial__image{width:calc(100% - 8px);box-shadow:8px 8px 0 var(--rust)}.mark-testimonial blockquote{font-size:27px;line-height:1.12}.daily-preview__intro .display-title{font-size:46px}.daily-preview__device video{max-height:72svh;box-shadow:8px 9px 0 var(--gold)}}
.product-quick-proof{display:flex;flex-wrap:wrap;gap:7px;margin:0 0 18px}.product-quick-proof span{padding:7px 9px;border:1px solid var(--ink);font-size:9px;font-weight:950;letter-spacing:.9px;text-transform:uppercase}
.product-quick-review{margin:18px 0 0;padding:15px 17px;border-left:4px solid var(--gold);background:var(--tan);font-size:13px;font-weight:750;line-height:1.55}.product-quick-review>span{color:var(--rust);letter-spacing:2px}.product-quick-review cite{display:block;margin-top:5px;font-size:9px;font-style:normal;font-weight:900;letter-spacing:.8px;text-transform:uppercase}
.mark-card{display:grid;grid-template-columns:64px minmax(0,1fr);gap:14px;align-items:start;margin:0;padding:14px 16px;border:2px solid var(--ink);background:var(--tan)}
.mark-card__photo{width:64px;height:64px;overflow:hidden;border:2px solid var(--ink);background:var(--brown)}.mark-card__photo img{display:block;width:100%;height:100%;object-fit:cover}
.mark-card__stars{display:block;color:var(--rust);font-size:13px;letter-spacing:2px}
.mark-card blockquote{margin:4px 0 8px;padding:0;border:0;font-size:14px;font-weight:750;line-height:1.5}
.mark-card__by{margin:0;color:var(--brown);font-size:11px;line-height:1.5}.mark-card__by strong{color:var(--ink)}.mark-card__by a{color:var(--ink);font-weight:900;text-underline-offset:3px}
@media(max-width:1000px),(pointer:coarse){.mark-card__by a{position:relative}.mark-card__by a::after{content:'';position:absolute;inset:-16px -8px}}
@media(max-width:1000px){.product-page .product-layout{display:flex!important;flex-direction:column!important;gap:28px}.product-page .product-media-column{display:contents!important}.product-page .product-gallery-wrap{order:1!important}.product-page .product-info{order:2!important}.product-page .product-details{order:3!important}.product-page .featured-reviews--column{order:4!important}.product-info .eyebrow{margin-bottom:6px}.product-info h1{margin-top:0}.product-form{margin-top:20px}}
{% endstylesheet %}
